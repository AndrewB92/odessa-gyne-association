---
import type { CollectionEntry } from "astro:content";

import SpeakersGrid from "../SpeakersGrid.astro";

type Lang = "uk" | "en";

interface Props {
  speakers: CollectionEntry<"speakers">[];
  lang: Lang;
}

const {
  speakers,
  lang,
} = Astro.props;

const copy = {
  uk: {
    eyebrow: "Професійна спільнота",
    title: "Спікери",
    description:
      "Фахівці у сфері акушерства, гінекології, репродуктивної медицини та суміжних напрямів, які беруть участь у професійних і освітніх заходах ОВ ААГУ.",
    emptyTitle: "Спікерів поки не додано",
    emptyDescription:
      "Інформація про спікерів з’явиться на цій сторінці після публікації.",
  },

  en: {
    eyebrow: "Professional community",
    title: "Speakers",
    description:
      "Specialists in obstetrics, gynecology, reproductive medicine and related fields who participate in the professional and educational activities of OB AAGU.",
    emptyTitle: "No speakers have been added yet",
    emptyDescription:
      "Speaker information will appear on this page after publication.",
  },
}[lang];

const sortedSpeakers = [...speakers].sort(
  (first, second) =>
    first.data.sort - second.data.sort ||
    first.data.name[lang].localeCompare(
      second.data.name[lang],
      lang === "uk" ? "uk-UA" : "en",
    ),
);

const hasSpeakers = sortedSpeakers.length > 0;
---

<section class="page-shell page-hero">
  <div class="page-container">
    <header class="page-header">
      <p class="page-eyebrow">
        {copy.eyebrow}
      </p>

      <h1 class="page-title">{copy.title}</h1>

      <p class="page-intro">
        {copy.description}
      </p>
    </header>

    {
      hasSpeakers ? (
        <SpeakersGrid
          speakers={sortedSpeakers}
          lang={lang}
        />
      ) : (
        <div class="speakers-empty">
          <h2>{copy.emptyTitle}</h2>
          <p>{copy.emptyDescription}</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .speakers-empty {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-brand-200);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
  }

  .speakers-empty h2 {
    margin: 0;
    color: var(--color-brand-900);
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .speakers-empty p {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
</style>
