---
type Columns = 1 | 2 | 3;

type Props = {
  columns?: Columns;
  class?: string;
};

const { columns = 1 } = Astro.props;
const className = Astro.props.class;
---

<div class:list={['content-list', `content-list--${columns}`, className]}>
  <slot />
</div>

<style>
  .content-list {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (min-width: 860px) {
    .content-list--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .content-list--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>