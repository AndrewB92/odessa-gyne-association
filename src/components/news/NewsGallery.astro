---
import type { Lang, NewsPost } from "../../lib/news";

type Props = {
  gallery: NewsPost["data"]["gallery"];
  lang: Lang;
};

const { gallery, lang } = Astro.props;
const title = lang === "en" ? "Photo gallery" : "Фотогалерея";
---

{
  gallery.length > 0 && (
    <section class="news-gallery" aria-labelledby="news-gallery-title">
      <h2 id="news-gallery-title">{title}</h2>

      <div class="news-gallery__grid">
        {gallery.map((item) => (
          <figure class="news-gallery__item">
            <img
              src={item.image}
              alt={item.alt[lang]}
              loading="lazy"
              decoding="async"
            />

            {item.caption?.[lang] && (
              <figcaption>{item.caption[lang]}</figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .news-gallery {
    margin-top: 3rem;
  }

  .news-gallery h2 {
    margin: 0 0 1.25rem;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .news-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .news-gallery__item {
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(136, 19, 55, 0.12);
    border-radius: 1.1rem;
    background: #fff;
  }

  .news-gallery__item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .news-gallery__item figcaption {
    padding: 0.85rem 1rem;
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .news-gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>