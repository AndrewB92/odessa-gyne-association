---
import type { Lang, NewsPost } from "../../lib/news";
import { getYouTubeEmbedUrl } from "../../utils/youtube";

type Props = {
  videos: NewsPost["data"]["videos"];
  lang: Lang;
};

const { videos, lang } = Astro.props;
const title = lang === "en" ? "Video" : "Відео";
const fallbackTitle = lang === "en" ? "YouTube video" : "Відео з YouTube";
---

{
  videos.length > 0 && (
    <section class="news-videos" aria-labelledby="news-videos-title">
      <h2 id="news-videos-title">{title}</h2>

      <div class="news-videos__list">
        {videos.map((video) => {
          const embedUrl = getYouTubeEmbedUrl(video.url);
          const videoTitle = video.title?.[lang] || fallbackTitle;

          return (
            embedUrl && (
              <figure class="news-videos__item">
                <div class="news-videos__frame">
                  <iframe
                    src={embedUrl}
                    title={videoTitle}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>
                </div>

                {video.title?.[lang] && (
                  <figcaption>{video.title[lang]}</figcaption>
                )}
              </figure>
            )
          );
        })}
      </div>
    </section>
  )
}

<style>
  .news-videos {
    margin-top: 3rem;
  }

  .news-videos h2 {
    margin: 0 0 1.25rem;
    color: var(--color-brand-900);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .news-videos__list {
    display: grid;
    gap: 1.5rem;
  }

  .news-videos__item {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-brand);
    border-radius: 1.1rem;
    background: var(--color-surface);
  }

  .news-videos__frame {
    aspect-ratio: 16 / 9;
    background: var(--color-brand-900);
  }

  .news-videos iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .news-videos figcaption {
    padding: 0.85rem 1rem;
    color: var(--color-text-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
