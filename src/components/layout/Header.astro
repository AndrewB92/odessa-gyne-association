---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import { primaryNavigation, languageNavigation } from '../../data/navigation';

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }

  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />

    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul class="site-header__nav-list">
        {primaryNavigation.map((item) => (
          <li>
            <a
              class:list={['site-header__nav-link', isActive(item.href) && 'is-active']}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <nav class="site-header__langs" aria-label="Language navigation">
        {languageNavigation.map((item) => (
          <a
            class:list={['site-header__lang', isActive(item.href) && 'is-active']}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <Button href="/contacts/" size="small">Contact</Button>
    </div>
  </div>
</header>