---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import type { Language } from '../../i18n/config';
import type { RouteKey } from '../../i18n/routes';
import { getPrimaryNavigation, getLanguageNavigation } from '../../data/navigation';
import { useTranslations } from '../../i18n/ui';

type Props = {
  lang: Language;
  route?: RouteKey;
};

const { lang, route = 'home' } = Astro.props;

const currentPath = Astro.url.pathname;
const primaryNavigation = getPrimaryNavigation(lang);
const languageNavigation = getLanguageNavigation(route);
const t = useTranslations(lang);

const isActive = (href: string) => {
  if (href === '/ua/' || href === '/en/') {
    return currentPath === href;
  }

  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo lang={lang} />

    <nav class="site-header__nav" aria-label="Primary navigation">
      <ul class="site-header__nav-list">
        {primaryNavigation.map((item) => (
          <li>
            <a
              class:list={['site-header__nav-link', isActive(item.href) && 'is-active']}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <nav class="site-header__langs" aria-label="Language navigation">
        {languageNavigation.map((item) => (
          <a
            class:list={['site-header__lang', item.lang === lang && 'is-active']}
            href={item.href}
            aria-current={item.lang === lang ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <Button href={primaryNavigation.find((item) => item.route === 'contacts')?.href ?? '/contacts/'} size="small">
        {t.common.contact}
      </Button>
    </div>
  </div>
</header>