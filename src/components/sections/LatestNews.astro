---
import { getCollection } from 'astro:content';
import ContentCard from '../content/ContentCard.astro';
import ContentList from '../content/ContentList.astro';
import Button from '../ui/Button.astro';
import EmptyState from '../ui/EmptyState.astro';
import Section from '../ui/Section.astro';
import type { Language } from '../../i18n/config';
import { getRoute } from '../../i18n/routes';

type Props = {
  lang: Language;
};

const { lang } = Astro.props;

const content = {
  ua: {
    eyebrow: 'Новини',
    title: 'Останні новини',
    lead: 'Оновлення, оголошення та новини професійної спільноти.',
    all: 'Усі новини',
    emptyTitle: 'Новин поки немає',
    emptyDescription: 'Новини та оголошення з’являться тут після додавання.',
    fallbackEyebrow: 'Новини',
  },
  en: {
    eyebrow: 'News',
    title: 'Latest news',
    lead: 'Recent updates, announcements, and professional community news.',
    all: 'All news',
    emptyTitle: 'No news yet',
    emptyDescription: 'News and announcements will appear here after they are added.',
    fallbackEyebrow: 'News',
  },
} as const;

const t = content[lang];

const news = (await getCollection('news'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Section eyebrow={t.eyebrow} title={t.title} lead={t.lead}>
  <div class="section-actions">
    <Button href={getRoute('news', lang)} variant="secondary">{t.all}</Button>
  </div>

  <ContentList columns={3}>
    {news.length > 0 ? (
      news.map((item) => (
        <ContentCard
          title={item.data.title}
          description={item.data.description}
          eyebrow={item.data.category ?? t.fallbackEyebrow}
          date={item.data.date}
          href={`${getRoute('news', lang)}${item.id}/`}
        />
      ))
    ) : (
      <EmptyState title={t.emptyTitle} description={t.emptyDescription} />
    )}
  </ContentList>
</Section>

<style>
  .section-actions {
    margin-top: var(--space-md);
  }
</style>