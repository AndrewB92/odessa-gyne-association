---
import { getCollection } from 'astro:content';
import ContentCard from '../content/ContentCard.astro';
import ContentList from '../content/ContentList.astro';
import Button from '../ui/Button.astro';
import EmptyState from '../ui/EmptyState.astro';
import Section from '../ui/Section.astro';
import type { Language } from '../../i18n/config';
import { getRoute } from '../../i18n/routes';

type Props = {
  lang: Language;
};

const { lang } = Astro.props;

const content = {
  ua: {
    eyebrow: 'Події',
    title: 'Найближчі події',
    lead: 'Конференції, лекції, зустрічі та освітні заходи для професійної спільноти.',
    all: 'Усі події',
    featured: 'Важлива подія',
    fallbackEyebrow: 'Подія',
    emptyTitle: 'Найближчих подій поки немає',
    emptyDescription: 'Нові події з’являться тут після додавання.',
  },
  en: {
    eyebrow: 'Events',
    title: 'Upcoming events',
    lead: 'Conferences, lectures, meetings, and educational events for the professional community.',
    all: 'All events',
    featured: 'Featured event',
    fallbackEyebrow: 'Event',
    emptyTitle: 'No upcoming events yet',
    emptyDescription: 'New events will appear here after they are added.',
  },
} as const;

const t = content[lang];
const now = new Date();

const events = (await getCollection('events'))
  .filter((item) => !item.data.draft)
  .filter((item) => item.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);
---

<Section eyebrow={t.eyebrow} title={t.title} lead={t.lead}>
  <div class="section-actions">
    <Button href={getRoute('events', lang)} variant="secondary">{t.all}</Button>
  </div>

  <ContentList columns={3}>
    {events.length > 0 ? (
      events.map((item) => (
        <ContentCard
          title={item.data.title}
          description={item.data.description}
          eyebrow={item.data.featured ? t.featured : t.fallbackEyebrow}
          date={item.data.date}
          meta={item.data.location}
          href={`${getRoute('events', lang)}${item.id}/`}
        />
      ))
    ) : (
      <EmptyState title={t.emptyTitle} description={t.emptyDescription} />
    )}
  </ContentList>
</Section>

<style>
  .section-actions {
    margin-top: var(--space-md);
  }
</style>