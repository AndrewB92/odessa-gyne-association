---
import Button from '../ui/Button.astro';
---

<section class="home-hero">
  <div class="container home-hero__inner">
    <div class="home-hero__content">
      <p class="eyebrow">Professional medical association</p>

      <h1>
        Association of Obstetricians and Gynecologists of Odessa Region
      </h1>

      <p class="home-hero__lead">
        A professional community focused on medical education, clinical collaboration,
        research, public health projects, and support for specialists across the region.
      </p>

      <div class="home-hero__actions">
        <Button href="/association/">About the association</Button>
        <Button href="/events/" variant="secondary">Upcoming events</Button>
      </div>
    </div>

    <aside class="home-hero__note card" aria-label="Association focus">
      <p class="eyebrow">Focus</p>
      <h2>Education, cooperation and clinical practice.</h2>
      <p>
        The new website is being rebuilt around clear access to events, documents,
        news, projects, and professional information.
      </p>
    </aside>
  </div>
</section>

<style>
  .home-hero {
    padding-block: clamp(5rem, 4rem + 5vw, 9rem) var(--space-2xl);
  }

  .home-hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .home-hero__content {
    max-width: 820px;
  }

  .home-hero h1 {
    max-width: 900px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.75rem, 1.55rem + 6vw, 7.5rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .home-hero__lead {
    max-width: 680px;
    margin: var(--space-lg) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.08rem, 0.98rem + 0.5vw, 1.35rem);
    line-height: 1.65;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-lg);
  }

  .home-hero__note {
    max-width: 460px;
    padding: var(--space-lg);
  }

  .home-hero__note h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.25rem + 1.6vw, 2.45rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .home-hero__note p:last-child {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 960px) {
    .home-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.42fr);
    }
  }
</style>