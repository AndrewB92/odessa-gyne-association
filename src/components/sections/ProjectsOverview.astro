---
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';

const projects = [
  {
    title: 'Professional education',
    description: 'Lectures, meetings, conferences, and continuous education for specialists.',
  },
  {
    title: 'Clinical cooperation',
    description: 'Exchange of experience, practical recommendations, and professional discussion.',
  },
  {
    title: 'Public health initiatives',
    description: 'Projects focused on women’s health, awareness, prevention, and regional cooperation.',
  },
];
---

<Section
  eyebrow="Projects"
  title="Projects and professional initiatives"
  lead="The association brings together educational, clinical, and public health activity into structured long-term work."
>
  <div class="section-actions">
    <Button href="/projects/" variant="secondary">All projects</Button>
  </div>

  <div class="project-grid">
    {projects.map((project) => (
      <article class="project-card card">
        <h3>{project.title}</h3>
        <p>{project.description}</p>
      </article>
    ))}
  </div>
</Section>

<style>
  .section-actions {
    margin-top: var(--space-md);
  }

  .project-grid {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .project-card {
    padding: var(--space-lg);
  }

  .project-card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem);
    line-height: 1.1;
  }

  .project-card p {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 860px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>