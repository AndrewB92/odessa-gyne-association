---
import Icon from "../Icon.astro";
import EventMeta from "./EventMeta.astro";

import type {
  EventFormat,
  EventLinkMode,
  EventLocation,
  EventScheduleItem,
  OptionalLocalizedText,
  SiteLocale,
} from "../../types/events";

import {
  getEventLabels,
} from "../../utils/eventLabels";

import {
  getEventLink,
} from "../../utils/eventLinks";

interface Props {
  type: "conference" | "bpr";
  locale: SiteLocale;

  slug: string;

  title: {
    uk: string;
    en: string;
  };

  excerpt?: OptionalLocalizedText;

  schedule: EventScheduleItem[];
  locations?: EventLocation[];
  format: EventFormat;

  linkMode?: EventLinkMode;
  externalUrl?: string;
  externalBlank?: boolean;

  category?: {
    slug: string;
    title: {
      uk: string;
      en: string;
    };
  };

  bprPoints?: number;
  providerNumber?: string;

  class?: string;
}

const {
  type,
  locale,
  slug,
  title,
  excerpt,
  schedule,
  locations = [],
  format,
  linkMode = "internal",
  externalUrl,
  externalBlank = true,
  category,
  bprPoints,
  providerNumber,
  class: className = "",
} = Astro.props;

const labels = getEventLabels(locale);

const localizedTitle = title[locale]?.trim();
const localizedExcerpt = excerpt?.[locale]?.trim();
const localizedCategoryTitle = category?.title?.[locale]?.trim();

const eventLink = getEventLink({
  type,
  slug,
  locale,
  linkMode,
  externalUrl,
  category: category?.slug,
});

const shouldOpenInNewTab =
  eventLink.external && externalBlank !== false;

const linkLabel = eventLink.external
  ? labels.openExternal
  : labels.open;
---

<article class:list={["event-card", className]}>
  <div class="event-card__body">
    {
      type === "bpr" &&
      category &&
      localizedCategoryTitle && (
        <a
          class="event-card__category"
          href={
            locale === "en"
              ? `/en/bpr/${category.slug}/`
              : `/bpr/${category.slug}/`
          }
        >
          {localizedCategoryTitle}
        </a>
      )
    }

    <h2 class="event-card__title">
      <a
        href={eventLink.href}
        target={shouldOpenInNewTab ? "_blank" : undefined}
        rel={
          shouldOpenInNewTab
            ? "noopener noreferrer"
            : undefined
        }
      >
        {localizedTitle}
      </a>
    </h2>

    {
      localizedExcerpt && (
        <p class="event-card__excerpt">
          {localizedExcerpt}
        </p>
      )
    }

    <EventMeta
      locale={locale}
      schedule={schedule}
      locations={locations}
      format={format}
      bprPoints={bprPoints}
      providerNumber={providerNumber}
      compact
      class="event-card__meta"
    />
  </div>

  <div class="event-card__footer">
    <a
      class="event-card__link"
      href={eventLink.href}
      target={shouldOpenInNewTab ? "_blank" : undefined}
      rel={
        shouldOpenInNewTab
          ? "noopener noreferrer"
          : undefined
      }
    >
      <span>{linkLabel}</span>

      <Icon
        name={
          shouldOpenInNewTab
            ? "external-link"
            : "arrow-right"
        }
        size={17}
      />
    </a>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border-brand);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: var(--transition-card);
  }

  .event-card:hover {
    border-color: var(--color-border-brand-hover);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-0.25rem);
  }

  .event-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1.125rem, 2vw, 1.5rem);
  }

  .event-card__category {
    align-self: flex-start;
    max-width: 100%;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-pill);
    color: var(--color-brand-600);
    background: var(--color-brand-100);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.045em;
    overflow-wrap: anywhere;
  }

  .event-card__category:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .event-card__title {
    margin: 0;
    color: var(--color-brand-900);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.25;
  }

  .event-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .event-card__title a:hover {
    color: var(--color-brand-600);
  }

  .event-card__excerpt {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .event-card__meta {
    margin-top: auto;
  }

  .event-card__footer {
    padding:
      0
      clamp(1.125rem, 2vw, 1.5rem)
      clamp(1.125rem, 2vw, 1.5rem);
  }

  .event-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-brand-600);
    border-radius: var(--radius-sm);
    color: var(--color-brand-600);
    background: transparent;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .event-card__link:hover {
    color: var(--color-surface);
    background: var(--color-brand-600);
    transform: translateX(1px);
  }

  .event-card__link:focus-visible,
  .event-card__title a:focus-visible,
  .event-card__category:focus-visible {
    outline: 3px solid
      color-mix(
        in srgb,
        var(--color-brand-400) 45%,
        transparent
      );
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card,
    .event-card__link {
      transition: none;
    }

    .event-card:hover,
    .event-card__link:hover {
      transform: none;
    }
  }
</style>
