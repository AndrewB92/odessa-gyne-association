              <p class="text-lg text-rose-900/70 leading-relaxed">{t.about.p3}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="activities" class="py-24 lg:py-32 bg-gradient-to-b from-rose-50/50 to-white">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
