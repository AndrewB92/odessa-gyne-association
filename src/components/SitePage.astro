import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import SpeakersGrid from './SpeakersGrid.astro';
import NewsCard from './NewsCard.astro';
import type { CollectionEntry } from 'astro:content';

type Lang = 'uk' | 'en';

type PageKey = 'home' | 'about-us' | 'docs' | 'work' | 'involved' | 'vidrodjenya';

type Props = {
  lang?: Lang;
  page?: PageKey;
  currentPath?: string;
  speakers?: any[];
  latestNews?: CollectionEntry<'news'>[];
  newsCategories?: CollectionEntry<'newsCategories'>[];
};

type LocalizedLabel = Record<Lang, string>;
type DocumentLink = readonly [LocalizedLabel, string];

const {
  lang = 'uk',
  page = 'home',
  currentPath = '/',
  speakers = [],
  latestNews = [],
  newsCategories = [],
} = Astro.props as Props;

const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';

const newsCategoryMap = new Map(
  newsCategories.map((category) => [category.data.slug, category])
);

