                    <Icon name={icon} size={24} class="text-rose-300 mb-3 transition-transform duration-300 group-hover:scale-110" />
                    <p class="font-heading text-2xl font-bold text-rose-900">{value}</p>
                    <p class="text-sm text-rose-900/50 mt-1">{label}</p>
