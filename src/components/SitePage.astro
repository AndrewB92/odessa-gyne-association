                <a href={`${prefix}/vidrodjenya`} class="group inline-flex items-center gap-2 self-start px-6 py-3 bg-rose-300 text-white rounded-full text-sm font-medium transition-all duration-300 hover:bg-rose-500 hover:shadow-lg hover:shadow-rose-300/25 hover:scale-[1.02]">{t.renaissance.cta}<Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" /></a>
