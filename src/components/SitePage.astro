            </div>
            {t.membership.tabs.map(([id, , , items], index) => (
              <div data-panel={id} class={`${index === 0 ? '' : 'hidden'} bg-white rounded-[1.5rem] p-8 lg:p-10 shadow-[0_10px_30px_rgba(74,59,59,0.05)]`}>
                <ul class="space-y-4">
                  {items.map((item, i) => <li class="flex gap-4 items-start"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-rose-100 flex items-center justify-center text-xs font-semibold text-rose-400 mt-0.5">{i + 1}</span><p class="text-rose-900/70 leading-relaxed">{item}</p></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section> */}
      <section id="membership" class="py-24 lg:py-32">
        <div class="max-w-4xl mx-auto px-6 lg:px-8">
          <div class="text-center mb-14">
            <span class="inline-block px-4 py-1.5 rounded-full bg-rose-100 text-rose-500 text-xs font-semibold tracking-widest uppercase mb-6">
              {t.membership.badge}
            </span>

            <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-rose-900 leading-tight">
              {t.membership.title}
            </h2>
          </div>

          <div>
            <div class="flex justify-center gap-2 mb-10 flex-wrap" data-tabs>
              {t.membership.tabs.map(([id, label, icon], index) => (
                <button
                  data-tab={id}
                  class={`flex items-center gap-2 px-5 py-3 rounded-full text-sm font-medium transition-all duration-300 ${
                    index === 0
                      ? 'bg-rose-300 text-white shadow-lg shadow-rose-300/20'
                      : 'bg-rose-50 text-rose-900/60 hover:bg-rose-100 hover:text-rose-900'
                  }`}
                >
                  <Icon name={icon} size={16} />
                  {label}
                </button>
              ))}
            </div>

            {t.membership.tabs.map(([id, , , items], index) => (
              <div
                data-panel={id}
                class={`${index === 0 ? '' : 'hidden'} bg-white rounded-[1.5rem] p-8 lg:p-10 shadow-[0_10px_30px_rgba(74,59,59,0.05)]`}
              >
                <ul class="space-y-4">
                  {items.map((item, i) => (
                    <li class="flex gap-4 items-start">
                      <span class="flex-shrink-0 w-6 h-6 rounded-full bg-rose-100 flex items-center justify-center text-xs font-semibold text-rose-400 mt-0.5">
                        {i + 1}
                      </span>

                      <p class="text-rose-900/70 leading-relaxed">{item}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            <div class="membership-statutory">
              <h3>{t.membership.statutoryTitle}</h3>

              <ol>
                {t.membership.statutoryItems.map((item, index) => (
                  <li>
                    <span>{index + 1}</span>
                    <p>{item}</p>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
      </section>

      <section id="presidium" class="py-24 lg:py-32 bg-gradient-to-b from-white to-rose-50/50">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
