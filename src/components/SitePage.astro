        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-bounce"><div class="w-6 h-10 rounded-full border-2 border-rose-300/40 flex justify-center pt-2"><div class="w-1 h-2 rounded-full bg-rose-300/60"></div></div></div>
      </section>

      <section id="renaissance" class="py-24 lg:py-32">
