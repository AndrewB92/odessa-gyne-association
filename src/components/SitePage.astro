<script>
  document.querySelectorAll('[data-tabs]').forEach((tabs) => {
    const buttons = Array.from(tabs.querySelectorAll('[data-tab]'));
    const panels = buttons.map((button) => document.querySelector(`[data-panel="${button.getAttribute('data-tab')}"]`));
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('bg-rose-300', 'text-white', 'shadow-lg', 'shadow-rose-300/20');
          b.classList.add('bg-rose-50', 'text-rose-900/60');
        });
        panels.forEach((panel) => panel?.classList.add('hidden'));
        button.classList.add('bg-rose-300', 'text-white', 'shadow-lg', 'shadow-rose-300/20');
        button.classList.remove('bg-rose-50', 'text-rose-900/60');
        panels[index]?.classList.remove('hidden');
      });
    });
  });
</script>

