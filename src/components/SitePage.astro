                <div class="w-12 h-12 rounded-2xl bg-rose-100 flex items-center justify-center mb-5 transition-all duration-300 group-hover:bg-rose-300 group-hover:scale-110"><Icon name={icon} size={22} class="text-rose-400 transition-colors duration-300 group-hover:text-white" /></div>
