---
---
<div class="rich-content">
  <slot />
</div>

<style>
  .rich-content {
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .rich-content :global(*) {
    max-width: 100%;
  }

  .rich-content :global(h2),
  .rich-content :global(h3),
  .rich-content :global(h4) {
    margin: 2.2em 0 0.75em;
    color: var(--color-brand-900);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.2;
  }

  .rich-content :global(h2) {
    font-size: clamp(1.65rem, 3vw, 2.25rem);
  }

  .rich-content :global(h3) {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
  }

  .rich-content :global(p),
  .rich-content :global(ul),
  .rich-content :global(ol),
  .rich-content :global(blockquote),
  .rich-content :global(table) {
    margin: 0 0 1.25rem;
  }

  .rich-content :global(a) {
    color: var(--color-brand-600);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .rich-content :global(ul),
  .rich-content :global(ol) {
    padding-left: 1.35rem;
  }

  .rich-content :global(li + li) {
    margin-top: 0.4rem;
  }

  .rich-content :global(blockquote) {
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-brand-500);
    border-radius: 0 1rem 1rem 0;
    background: var(--color-brand-50);
    color: var(--color-brand-900);
  }

  .rich-content :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .rich-content :global(th),
  .rich-content :global(td) {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border-brand);
    text-align: left;
    vertical-align: top;
  }

  .rich-content :global(th) {
    background: var(--color-brand-50);
    color: var(--color-brand-900);
    font-weight: 800;
  }

  .rich-content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: 1.25rem;
  }
</style>
