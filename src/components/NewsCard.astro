---
import type { CollectionEntry } from "astro:content";
import {
  formatNewsDate,
  getNewsPostUrl,
  isExternalNewsPost,
  type Lang,
} from "../lib/news";

type Props = {
  post: CollectionEntry<"news">;
  category?: CollectionEntry<"newsCategories">;
  lang: Lang;
};

const { post, category, lang } = Astro.props;
const isExternal = isExternalNewsPost(post);
const href = getNewsPostUrl(post, lang);
const title = post.data.title[lang];
const excerpt = post.data.excerpt?.[lang];
const imageAlt = post.data.imageAlt?.[lang] || title;
---

<a
  class="news-card"
  href={href}
  target={isExternal && post.data.redirectBlank ? "_blank" : undefined}
  rel={isExternal && post.data.redirectBlank ? "noopener noreferrer" : undefined}
>
  {post.data.image && (
    <img
      class="news-card__image"
      src={post.data.image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
    />
  )}

  <div class="news-card__body">
    <div class="news-card__meta">
      {category && <span>{category.data.title[lang]}</span>}
      <time datetime={post.data.publishedAt.toISOString()}>
        {formatNewsDate(post.data.publishedAt, lang)}
      </time>
    </div>

    <h2>{title}</h2>

    {excerpt && <p>{excerpt}</p>}

    <span class="news-card__link">
      {isExternal
        ? lang === "en"
          ? "Open resource"
          : "Відкрити матеріал"
        : lang === "en"
          ? "Read more"
          : "Читати далі"}
    </span>
  </div>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 100%;
    border: 1px solid rgba(136, 19, 55, 0.14);
    border-radius: 1.5rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 45px rgba(136, 19, 55, 0.08);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    border-color: rgba(136, 19, 55, 0.35);
    box-shadow: 0 24px 60px rgba(136, 19, 55, 0.14);
  }

  .news-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #fff1f4;
  }

  .news-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.35rem;
  }

  .news-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-bottom: 0.85rem;
    color: #be123c;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-card h2 {
    margin: 0;
    color: #881337;
    font-size: clamp(1rem, 2vw, 1.22rem);
    line-height: 1.25;
  }

  .news-card p {
    margin: 0.85rem 0 0;
    color: #475569;
    line-height: 1.65;
  }

  .news-card__link {
    margin-top: auto;
    padding-top: 1.35rem;
    color: #be123c;
    font-weight: 800;
  }
</style>