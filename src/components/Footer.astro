---
import Icon from './Icon.astro';

const { lang = 'uk' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const footer = isEn
  ? {
      brand: 'Odessa Branch of the Association of Obstetricians and Gynecologists of Ukraine',
      brandShort: 'OB AAGU',
      nav: 'Navigation',
      contacts: 'Contacts',
      copyright: '© 2025 OB AAGU. All rights reserved.',
      links: [
        ['About', '/about-us'],
        ['Activities', '/work'],
        ['Documents', '/docs'],
        ['Community', '/involved'],
        ['Renaissance', '/vidrodjenya'],
      ],
    }
  : {
      brand: 'Одеське відділення Асоціації акушерів-гінекологів України',
      brandShort: 'ОВ ААГУ',
      nav: 'Навігація',
      contacts: 'Контакти',
      copyright: '© 2025 ОВ ААГУ. Усі права захищені.',
      links: [
        ['Про асоціацію', '/about-us'],
        ['Діяльність', '/work'],
        ['Документи', '/docs'],
        ['Спільнота', '/involved'],
        ['Відродження', '/vidrodjenya'],
      ],
    };
const contacts = [
  { role: isEn ? 'Chair of Presidium' : 'Голова Президії', name: 'Манасова Гульсим Серікбаївна', phone: '+38 (050) 502 70 58', href: 'tel:+380505027058' },
  { role: isEn ? 'Secretary' : 'Секретар', name: 'Кузьмин Наталія Василівна', phone: '+38 (097) 686 82 36', href: 'tel:+380976868236' },
  { role: isEn ? 'OB AAGU contacts' : 'Контакти ОВ ААГУ', phone: '+38 (048) 705 99 78', href: 'tel:+380487059978', email: 'aagu.od@gmail.com' },
];
---

<footer class="bg-rose-900 text-white/80">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <div class="lg:col-span-1">
        <a href={isEn ? '/en/' : '/'} class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-full bg-rose-300 flex items-center justify-center text-white font-heading font-bold text-sm">OB</div>
          <span class="font-heading text-white font-semibold text-sm">{footer.brandShort}</span>
        </a>
        <p class="text-sm text-white/50 leading-relaxed mb-6 max-w-xs">{footer.brand}</p>
        <div class="flex items-center gap-3">
          <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 hover:bg-rose-300 hover:scale-110"><Icon name="instagram" size={16} /></a>
          <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 hover:bg-rose-300 hover:scale-110"><Icon name="facebook" size={16} /></a>
          <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 hover:bg-rose-300 hover:scale-110"><Icon name="send" size={16} /></a>
        </div>
      </div>
      <div>
        <h4 class="font-heading font-semibold text-white text-sm uppercase tracking-widest mb-6">{footer.nav}</h4>
        <ul class="space-y-3">
          {footer.links.map(([label, href]) => (
            <li><a href={`${prefix}${href}`} class="text-sm text-white/50 hover:text-rose-300 transition-colors duration-300">{label}</a></li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-2">
        <h4 class="font-heading font-semibold text-white text-sm uppercase tracking-widest mb-6">{footer.contacts}</h4>
        <div class="grid sm:grid-cols-3 gap-6">
          {contacts.map((contact) => (
            <div>
              <p class="text-xs text-rose-300 font-semibold mb-2">{contact.role}</p>
              {contact.name && <p class="text-sm text-white/70 mb-2 leading-snug">{contact.name}</p>}
              <a href={contact.href} class="flex items-center gap-2 text-sm text-white/50 hover:text-rose-300 transition-colors mb-1">
                <Icon name="phone" size={12} class="text-rose-300 flex-shrink-0" />{contact.phone}
              </a>
              {contact.email && (
                <a href={`mailto:${contact.email}`} class="flex items-center gap-2 text-sm text-white/50 hover:text-rose-300 transition-colors break-all">
                  <Icon name="mail" size={12} class="text-rose-300 flex-shrink-0" />{contact.email}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/30">{footer.copyright}</p>
      <p class="text-xs text-white/20">ov.aagu.od.ua</p>
    </div>
  </div>
</footer>
