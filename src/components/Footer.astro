---
import Icon from './Icon.astro';

const { lang = 'uk' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const currentYear = new Date().getFullYear();
const footer = isEn
  ? {
      brand:
        "Odesa Branch of the Association of Obstetricians and Gynecologists of Ukraine",
      brandShort: "OB AAGU",
      nav: "Navigation",
      contacts: "Contacts",
      copyright:
        `© ${currentYear} OB AAGU. All rights reserved.`,
      links: [
        ["About", "/about-us"],
        ["News", "/news"],
        ["Conferences", "/conferences"],
        ["BPR", "/bpr"],
        ["Speakers", "/speakers"],
        ["Documents", "/docs"],
        ["Community", "/involved"],
        ["Contacts", "/contacts"],
      ],
    }
  : {
      brand:
        "Одеське відділення Асоціації акушерів-гінекологів України",
      brandShort: "ОВ ААГУ",
      nav: "Навігація",
      contacts: "Контакти",
      copyright:
        `© ${currentYear} ОВ ААГУ. Усі права захищені.`,
      links: [
        ["Про асоціацію", "/about-us"],
        ["Новини", "/news"],
        ["Конференції", "/conferences"],
        ["БПР", "/bpr"],
        ["Спікери", "/speakers"],
        ["Документи", "/docs"],
        ["Спільнота", "/involved"],
        ["Контакти", "/contacts"],
      ],
    };
const contacts = [
  {
    role: isEn ? 'Chair of Presidium' : 'Голова Президії',
    name: isEn
      ? 'Gulsim Serikbaivna Manasova'
      : 'Манасова Гульсим Серікбаївна',
    phone: '+38 (050) 502 70 58',
    href: 'tel:+380505027058',
  },
  {
    role: isEn ? 'Secretary' : 'Секретар',
    name: isEn
      ? 'Nataliia Vasylivna Kuzmyn'
      : 'Кузьмин Наталія Василівна',
    phone: '+38 (097) 686 82 36',
    href: 'tel:+380976868236',
  },
  {
    role: isEn ? 'OB AAGU contacts' : 'Контакти ОВ ААГУ',
    phone: '+38 (048) 705 99 78',
    href: 'tel:+380487059978',
    email: 'aagu.od@gmail.com',
  },
];
---

<footer class="bg-rose-900 text-white/80">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <div class="lg:col-span-1">
        <a href={isEn ? '/en/' : '/'} class="flex items-center gap-3 mb-6">
          <svg
            class="w-10 h-10 transition-transform duration-300 group-hover:scale-105"
            viewBox="0 0 512 512"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-hidden="true"
          >
            <path fill="#034bec" d="M313.5 9.5c-10.3-2-20.6-3.2-31-3.5 40.5 10.5 70.3 34.3 89.5 71.5 15 37.9 13.6 75.2-4 112-19.9 35.1-49.8 56.6-89.5 64.5-53-3.4-95.5 15.8-127.5 57.5-22.4 36.6-26.7 75.2-13 116 14.3 33.8 38.1 58.1 71.5 73-80.3-15.4-140.1-58.7-179.5-130C-5.3 298.2-7.7 224.9 23 150.5 61.5 70.6 124.3 22.1 211.5 5c34.5-5.6 68.5-4.1 102 4.5Z"></path>
            <path fill="#f9517d" d="M313.5 9.5c66.7 16.2 118.9 52.9 156.5 110 46 76.9 52 156.9 18 240-29.7 63.1-76.9 107.6-141.5 133.5-38.6 14.8-78.3 19.1-119 13-6.3-1.4-12.3-3.2-18-5.5-33.4-14.9-57.2-39.2-71.5-73-13.7-40.8-9.4-79.4 13-116 32-41.7 74.5-60.9 127.5-57.5 39.7-7.9 69.6-29.4 89.5-64.5 17.6-36.8 19-74.1 4-112-19.2-37.2-49-61-89.5-71.5 10.4.3 20.7 1.5 31 3.5Z"></path>
            <path fill="#f9f9f9" d="M227.5 48.5c34.4-3.5 60.3 9.5 77.5 39 14.6 36.1 6.7 66.3-23.5 90.5-29.1 17.5-57.4 16.5-85-3-24.6-22-32.1-48.8-22.5-80.5 10.2-24.3 28-39.7 53.5-46Z"></path>
            <path fill="#faf9f9" d="M320.5 302.5c41.9-3.3 66.1 15.7 72.5 57 2.9 48.7-16.6 85.2-58.5 109.5-32.7 17.4-67 21.8-103 13-26.5-8-47.6-23.1-63.5-45.5-1-1.3-1.3-2.6-1-4 12.3 14.7 28.1 22.4 47.5 23 27.2-1.5 47-14.2 59.5-38 3.2-9.1 4.2-18.4 3-28-16.4-44.5-1.9-73.5 43.5-87Z"></path>
            <path fill="#fa547f" d="M324.5 342.5c9.4-1.7 16.3 1.6 20.5 10 .6 7.7-2.6 13.2-9.5 16.5-8.6 3.1-15.4 1-20.5-6.5-2.2-4.5-1.9-8.9 1-13 2.4-3 5.3-5.3 8.5-7Z"  ></path>
          </svg>
          <span class="font-heading text-white font-semibold text-sm">{footer.brandShort}</span>
        </a>
        <p class="text-sm text-white/50 leading-relaxed mb-6 max-w-xs">{footer.brand}</p>
        <div class="flex items-center gap-3">
          <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 hover:bg-rose-300 hover:scale-110"><Icon name="instagram" size={16} /></a>
          <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 hover:bg-rose-300 hover:scale-110"><Icon name="facebook" size={16} /></a>
          <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-all duration-300 hover:bg-rose-300 hover:scale-110"><Icon name="send" size={16} /></a>
        </div>
      </div>
      <div>
        <h4 class="font-heading font-semibold text-white text-sm uppercase tracking-widest mb-6">{footer.nav}</h4>
        <ul class="grid grid-cols-2 gap-x-5 gap-y-3">
          {footer.links.map(([label, href]) => (
            <li><a href={`${prefix}${href}`} class="text-sm text-white/50 hover:text-rose-300 transition-colors duration-300">{label}</a></li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-2">
        <h4 class="font-heading font-semibold text-white text-sm uppercase tracking-widest mb-6">{footer.contacts}</h4>
        <div class="grid sm:grid-cols-3 gap-6">
          {contacts.map((contact) => (
            <div>
              <p class="text-xs text-rose-300 font-semibold mb-2">{contact.role}</p>
              {contact.name && <p class="text-sm text-white/70 mb-2 leading-snug">{contact.name}</p>}
              <a href={contact.href} class="flex items-center gap-2 text-sm text-white/50 hover:text-rose-300 transition-colors mb-1">
                <Icon name="phone" size={12} class="text-rose-300 flex-shrink-0" />{contact.phone}
              </a>
              {contact.email && (
                <a href={`mailto:${contact.email}`} class="flex items-center gap-2 text-sm text-white/50 hover:text-rose-300 transition-colors break-all">
                  <Icon name="mail" size={12} class="text-rose-300 flex-shrink-0" />{contact.email}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-white/30">{footer.copyright}</p>
      <p class="text-xs text-white/20">ov.aagu.od.ua</p>
    </div>
  </div>
</footer>
