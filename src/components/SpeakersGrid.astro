---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Lang = "uk" | "en";

type Speaker = {
  id: string;
  data: {
    slug?: string;
    name: Record<Lang, string>;
    position: Record<Lang, string>;
    biography: Record<Lang, string>;
    photo?: string;
    sort: number;
  };
};

type Props = {
  speakers: Speaker[];
  lang: Lang;
};

const { speakers, lang } = Astro.props;

const speakerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/speakers/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

const isEn = lang === "en";
const basePath = isEn ? "/en/speakers" : "/speakers";

function getSpeakerUrl(speaker: Speaker) {
  return `${basePath}/${speaker.data.slug || speaker.id}/`;
}

function getSpeakerImage(photo?: string) {
  if (!photo) return null;
  return speakerImages[photo]?.default ?? null;
}
---

<div class="speakers-grid">
  {
    speakers.map((speaker) => {
      const image = getSpeakerImage(speaker.data.photo);

      return (
        <a class="speaker-card" href={getSpeakerUrl(speaker)}>
          {speaker.data.photo && (
            <img
              src={speaker.data.photo}
              alt={speaker.data.name[lang]}
              class="speaker-card__image"
              loading="lazy"
              decoding="async"
            />
          )}

          <div class="speaker-card__body">
            <h3>{speaker.data.name[lang]}</h3>
            <p>{speaker.data.position[lang]}</p>
          </div>
        </a>
      );
    })
  }
</div>

<style>
  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem;
  }

  .speaker-card {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(136, 19, 55, 0.14);
    border-radius: 1.25rem;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 45px rgba(136, 19, 55, 0.08);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .speaker-card:hover {
    transform: translateY(-4px);
    border-color: rgba(136, 19, 55, 0.35);
    box-shadow: 0 24px 60px rgba(136, 19, 55, 0.14);
  }

  .speaker-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .speaker-card__body {
    padding: 1.25rem;
  }

  .speaker-card__body h3 {
    margin: 0 0 0.5rem;
    color: #881337;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .speaker-card__body p {
    margin: 0;
    color: #475569;
    line-height: 1.5;
  }
</style>