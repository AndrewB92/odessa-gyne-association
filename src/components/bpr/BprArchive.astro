---
import type { CollectionEntry } from "astro:content";

import EventCard from "../events/EventCard.astro";

import type { SiteLocale } from "../../types/events";

import {
  getEventEndDate,
  getEventStartDate,
  isOngoingEvent,
  isPastEvent,
} from "../../utils/eventDates";

interface Props {
  events: CollectionEntry<"bprEvents">[];
  categories: CollectionEntry<"bprCategories">[];
  locale: SiteLocale;
}

interface ArchiveLabels {
  categoriesTitle: string;
  categoriesDescription: string;
  upcomingTitle: string;
  upcomingDescription: string;
  pastTitle: string;
  pastDescription: string;
  emptyTitle: string;
  emptyDescription: string;
  allEvents: string;
}

const labels: Record<SiteLocale, ArchiveLabels> = {
  uk: {
    categoriesTitle: "Категорії БПР",
    categoriesDescription:
      "Оберіть напрям, щоб переглянути відповідні освітні заходи.",
    upcomingTitle: "Актуальні заходи БПР",
    upcomingDescription:
      "Майбутні та поточні заходи безперервного професійного розвитку.",
    pastTitle: "Завершені заходи БПР",
    pastDescription:
      "Архів завершених освітніх заходів і доступних матеріалів.",
    emptyTitle: "Заходів БПР поки немає",
    emptyDescription:
      "Нові заходи з’являться на цій сторінці після публікації.",
    allEvents: "Усі заходи",
  },

  en: {
    categoriesTitle: "BPR categories",
    categoriesDescription:
      "Choose a category to view the relevant educational events.",
    upcomingTitle: "Current BPR events",
    upcomingDescription:
      "Upcoming and ongoing continuing professional development events.",
    pastTitle: "Completed BPR events",
    pastDescription:
      "An archive of completed educational events and available materials.",
    emptyTitle: "No BPR events yet",
    emptyDescription:
      "New events will appear on this page after publication.",
    allEvents: "All events",
  },
};

const {
  events,
  categories,
  locale,
} = Astro.props;

const copy = labels[locale];

const publishedCategories = categories
  .filter((category) => !category.data.draft)
  .sort(
    (first, second) =>
      first.data.sort - second.data.sort,
  );

const categoryMap = new Map(
  publishedCategories.map((category) => [
    category.data.slug,
    category,
  ]),
);

const publishedEvents = events.filter(
  (event) =>
    !event.data.draft &&
    categoryMap.has(event.data.category),
);

const upcomingEvents = publishedEvents
  .filter(
    (event) =>
      !isPastEvent(event.data.schedule),
  )
  .sort((first, second) => {
    const firstIsOngoing = isOngoingEvent(
      first.data.schedule,
    );

    const secondIsOngoing = isOngoingEvent(
      second.data.schedule,
    );

    if (firstIsOngoing !== secondIsOngoing) {
      return firstIsOngoing ? -1 : 1;
    }

    const firstStart = getEventStartDate(
      first.data.schedule,
    );

    const secondStart = getEventStartDate(
      second.data.schedule,
    );

    if (!firstStart && !secondStart) {
      return 0;
    }

    if (!firstStart) {
      return 1;
    }

    if (!secondStart) {
      return -1;
    }

    return firstStart.getTime() - secondStart.getTime();
  });

const pastEvents = publishedEvents
  .filter((event) =>
    isPastEvent(event.data.schedule),
  )
  .sort((first, second) => {
    const firstEnd = getEventEndDate(
      first.data.schedule,
    );

    const secondEnd = getEventEndDate(
      second.data.schedule,
    );

    if (!firstEnd && !secondEnd) {
      return 0;
    }

    if (!firstEnd) {
      return 1;
    }

    if (!secondEnd) {
      return -1;
    }

    return secondEnd.getTime() - firstEnd.getTime();
  });

const getCategoryPath = (slug: string) =>
  locale === "en"
    ? `/en/bpr/${slug}/`
    : `/bpr/${slug}/`;

const hasEvents = publishedEvents.length > 0;
---

<div class="bpr-archive">
  {
    publishedCategories.length > 0 && (
      <section
        class="bpr-categories"
        aria-labelledby="bpr-categories-title"
      >
        <header class="bpr-section-header">
          <h2
            id="bpr-categories-title"
            class="section-heading"
          >
            {copy.categoriesTitle}
          </h2>

          <p class="section-copy">
            {copy.categoriesDescription}
          </p>
        </header>

        <nav
          class="bpr-category-list"
          aria-label={copy.categoriesTitle}
        >
          <a
            class="bpr-category-link filter-chip filter-chip--active"
            href={
              locale === "en"
                ? "/en/bpr/"
                : "/bpr/"
            }
            aria-current="page"
          >
            {copy.allEvents}
          </a>

          {
            publishedCategories.map((category) => (
              <a
                class="bpr-category-link filter-chip"
                href={getCategoryPath(
                  category.data.slug,
                )}
              >
                {category.data.title[locale]}
              </a>
            ))
          }
        </nav>
      </section>
    )
  }

  {
    !hasEvents && (
      <div class="bpr-archive__empty empty-state">
        <h2>{copy.emptyTitle}</h2>
        <p>{copy.emptyDescription}</p>
      </div>
    )
  }

  {
    upcomingEvents.length > 0 && (
      <section
        class="bpr-event-group"
        aria-labelledby="upcoming-bpr-title"
      >
        <header class="bpr-section-header">
          <h2
            id="upcoming-bpr-title"
            class="section-heading"
          >
            {copy.upcomingTitle}
          </h2>

          <p class="section-copy">
            {copy.upcomingDescription}
          </p>
        </header>

        <div class="bpr-event-grid">
          {
            upcomingEvents.map((event) => {
              const category = categoryMap.get(
                event.data.category,
              );

              if (!category) {
                return null;
              }

              return (
                <EventCard
                  type="bpr"
                  locale={locale}
                  slug={event.data.slug}
                  title={event.data.title}
                  excerpt={event.data.excerpt}
                  schedule={event.data.schedule}
                  locations={event.data.locations}
                  format={event.data.format}
                  linkMode={event.data.linkMode}
                  externalUrl={
                    event.data.externalUrl
                  }
                  externalBlank={
                    event.data.externalBlank
                  }
                  bprPoints={
                    event.data.bprPoints
                  }
                  providerNumber={
                    event.data.providerNumber
                  }
                  category={{
                    slug: category.data.slug,
                    title: category.data.title,
                  }}
                />
              );
            })
          }
        </div>
      </section>
    )
  }

  {
    pastEvents.length > 0 && (
      <section
        class="bpr-event-group"
        aria-labelledby="past-bpr-title"
      >
        <header class="bpr-section-header">
          <h2
            id="past-bpr-title"
            class="section-heading"
          >
            {copy.pastTitle}
          </h2>

          <p class="section-copy">
            {copy.pastDescription}
          </p>
        </header>

        <div class="bpr-event-grid">
          {
            pastEvents.map((event) => {
              const category = categoryMap.get(
                event.data.category,
              );

              if (!category) {
                return null;
              }

              return (
                <EventCard
                  type="bpr"
                  locale={locale}
                  slug={event.data.slug}
                  title={event.data.title}
                  excerpt={event.data.excerpt}
                  schedule={event.data.schedule}
                  locations={event.data.locations}
                  format={event.data.format}
                  linkMode={event.data.linkMode}
                  externalUrl={
                    event.data.externalUrl
                  }
                  externalBlank={
                    event.data.externalBlank
                  }
                  bprPoints={
                    event.data.bprPoints
                  }
                  providerNumber={
                    event.data.providerNumber
                  }
                  category={{
                    slug: category.data.slug,
                    title: category.data.title,
                  }}
                />
              );
            })
          }
        </div>
      </section>
    )
  }
</div>

<style>
  .bpr-archive {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .bpr-categories,
  .bpr-event-group {
    display: grid;
    gap: 1.75rem;
  }

  .bpr-section-header {
    display: grid;
    gap: 0.625rem;
    max-width: 46rem;
  }

  .bpr-category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .bpr-category-link {
    max-width: 100%;
  }

  .bpr-event-grid {
    display: grid;
    grid-template-columns: repeat(
      1,
      minmax(0, 1fr)
    );
    gap: 1.25rem;
  }

  @media (max-width: 820px) {
    .bpr-event-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
