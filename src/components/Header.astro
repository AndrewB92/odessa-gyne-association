---
import Icon from './Icon.astro';

const { lang = 'uk', currentPath = '/' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const home = isEn ? '/en/' : '/';
const navItems = isEn
  ? [
      { label: 'About', href: '/about-us' },
      { label: 'Activities', href: '/work' },
      { label: 'Documents', href: '/docs' },
      { label: 'Community', href: '/involved' },
      { label: 'News', href: null },
    ]
  : [
      { label: 'Про асоціацію', href: '/about-us' },
      { label: 'Діяльність', href: '/work' },
      { label: 'Документи', href: '/docs' },
      { label: 'Спільнота', href: '/involved' },
      { label: 'Новини', href: null },
    ];
const route = currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
const ukHref = route === '/' ? '/' : route;
const enHref = route === '/' ? '/en/' : `/en${route}`;
---

<header
  id="site-header"
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 ${route === '/' ? 'bg-transparent' : 'bg-rose-50/90 backdrop-blur-xl shadow-sm'}`}
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href={home} class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-rose-300 flex items-center justify-center text-white font-heading font-bold text-sm transition-transform duration-300 group-hover:scale-105">OB</div>
        <span class="hidden sm:block font-heading text-rose-900 font-semibold text-sm leading-tight">{isEn ? 'OB AAGU' : 'ОВ ААГУ'}</span>
      </a>

      <nav class="hidden lg:flex items-center gap-8">
        {navItems.map((item) =>
          item.href ? (
            <a
              href={`${prefix}${item.href}`}
              class={`text-sm font-medium transition-colors duration-300 relative after:absolute after:bottom-[-4px] after:left-0 after:h-[2px] after:bg-rose-300 after:transition-all after:duration-300 ${route === item.href ? 'text-rose-300 after:w-full' : 'text-rose-900/70 hover:text-rose-300 after:w-0 hover:after:w-full'}`}
            >
              {item.label}
            </a>
          ) : (
            <span class="text-sm font-medium text-rose-900/30 cursor-default select-none">{item.label}</span>
          )
        )}
      </nav>

      <div class="flex items-center gap-4">
        <div class="hidden md:flex items-center gap-2">
          <a href="#" class="text-rose-900/40 hover:text-rose-300 transition-colors duration-300"><Icon name="instagram" size={16} /></a>
          <a href="#" class="text-rose-900/40 hover:text-rose-300 transition-colors duration-300"><Icon name="facebook" size={16} /></a>
          <a href="#" class="text-rose-900/40 hover:text-rose-300 transition-colors duration-300"><Icon name="send" size={16} /></a>
        </div>
        <div class="flex items-center bg-rose-100 rounded-full p-0.5">
          <a href={ukHref} class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300 ${!isEn ? 'bg-rose-300 text-white shadow-sm' : 'text-rose-900/60 hover:text-rose-900'}`}>Ukr</a>
          <a href={enHref} class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300 ${isEn ? 'bg-rose-300 text-white shadow-sm' : 'text-rose-900/60 hover:text-rose-900'}`}>En</a>
        </div>
        <button id="mobile-menu-button" class="lg:hidden text-rose-900/70 hover:text-rose-300 transition-colors" aria-label="Menu">
          <span data-menu-open><Icon name="menu" size={24} /></span>
          <span data-menu-close class="hidden"><Icon name="close" size={24} /></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden bg-rose-50/95 backdrop-blur-xl border-t border-rose-200/50 overflow-hidden">
    <nav class="px-6 py-6 flex flex-col gap-4">
      {navItems.map((item) =>
        item.href ? (
          <a href={`${prefix}${item.href}`} class="text-base font-medium text-rose-900/70 hover:text-rose-300 transition-colors duration-300">{item.label}</a>
        ) : (
          <span class="text-base font-medium text-rose-900/30 cursor-default">{item.label}</span>
        )
      )}
      <div class="flex items-center gap-4 pt-4 border-t border-rose-200/50">
        <a href="#" class="text-rose-900/40 hover:text-rose-300 transition-colors"><Icon name="instagram" size={18} /></a>
        <a href="#" class="text-rose-900/40 hover:text-rose-300 transition-colors"><Icon name="facebook" size={18} /></a>
        <a href="#" class="text-rose-900/40 hover:text-rose-300 transition-colors"><Icon name="send" size={18} /></a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = button?.querySelector('[data-menu-open]');
  const closeIcon = button?.querySelector('[data-menu-close]');
  const isHome = location.pathname === '/' || location.pathname === '/en/';

  function updateHeader() {
    if (!header || !isHome) return;
    if (window.scrollY > 20) {
      header.classList.add('bg-rose-50/90', 'backdrop-blur-xl', 'shadow-sm');
      header.classList.remove('bg-transparent');
    } else {
      header.classList.remove('bg-rose-50/90', 'backdrop-blur-xl', 'shadow-sm');
      header.classList.add('bg-transparent');
    }
  }

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
</script>
