---
import Icon from "./Icon.astro";

const { lang = "uk", currentPath = "/" } = Astro.props;
const isEn = lang === "en";
const prefix = isEn ? "/en" : "";
const home = isEn ? "/en/" : "/";
const navItems = isEn
  ? [
      {
        label: "About",
        href: "/about-us",
      },
      {
        label: "News",
        href: "/news",
      },
      {
        label: "Conferences",
        href: "/conferences",
      },
      {
        label: "BPR",
        href: "/bpr",
      },
      {
        label: "Speakers",
        href: "/speakers",
      },
      {
        label: "Documents",
        href: "/docs",
      },
      {
        label: "Community",
        href: "/involved",
      },
      {
        label: "Contacts",
        href: "/contacts",
      },
    ]
  : [
      {
        label: "Про асоціацію",
        href: "/about-us",
      },
      {
        label: "Новини",
        href: "/news",
      },
      {
        label: "Конференції",
        href: "/conferences",
      },
      {
        label: "БПР",
        href: "/bpr",
      },
      {
        label: "Спікери",
        href: "/speakers",
      },
      {
        label: "Документи",
        href: "/docs",
      },
      {
        label: "Спільнота",
        href: "/involved",
      },
      {
        label: "Контакти",
        href: "/contacts",
      },
    ];
const route = currentPath.replace(/^\/en(?=\/|$)/, "") || "/";
function isActiveRoute(href: string) {
  if (href === "/") {
    return route === "/";
  }

  return (
    route === href ||
    route.startsWith(`${href}/`)
  );
}
const ukHref = route === "/" ? "/" : route;
const enHref = route === "/" ? "/en/" : `/en${route}`;
---

<header
  id="site-header"
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 ${route === "/" ? "bg-transparent" : "bg-rose-50/90 backdrop-blur-xl shadow-sm"}`}
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- <a href={home} class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-rose-300 flex items-center justify-center text-white font-heading font-bold text-sm transition-transform duration-300 group-hover:scale-105">OB</div>
        <span class="hidden sm:block font-heading text-rose-900 font-semibold text-sm leading-tight">{isEn ? 'OB AAGU' : 'ОВ ААГУ'}</span>
      </a> -->
      <a
        href={home}
        class="flex items-center gap-3 group"
        aria-label={isEn ? "OB AAGU home" : "ОВ ААГУ головна"}
      >
        <svg
          class="w-10 h-10 transition-transform duration-300 group-hover:scale-105"
          viewBox="0 0 512 512"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-hidden="true"
        >
          <path fill="#034bec" d="M313.5 9.5c-10.3-2-20.6-3.2-31-3.5 40.5 10.5 70.3 34.3 89.5 71.5 15 37.9 13.6 75.2-4 112-19.9 35.1-49.8 56.6-89.5 64.5-53-3.4-95.5 15.8-127.5 57.5-22.4 36.6-26.7 75.2-13 116 14.3 33.8 38.1 58.1 71.5 73-80.3-15.4-140.1-58.7-179.5-130C-5.3 298.2-7.7 224.9 23 150.5 61.5 70.6 124.3 22.1 211.5 5c34.5-5.6 68.5-4.1 102 4.5Z"></path>
          <path fill="#f9517d" d="M313.5 9.5c66.7 16.2 118.9 52.9 156.5 110 46 76.9 52 156.9 18 240-29.7 63.1-76.9 107.6-141.5 133.5-38.6 14.8-78.3 19.1-119 13-6.3-1.4-12.3-3.2-18-5.5-33.4-14.9-57.2-39.2-71.5-73-13.7-40.8-9.4-79.4 13-116 32-41.7 74.5-60.9 127.5-57.5 39.7-7.9 69.6-29.4 89.5-64.5 17.6-36.8 19-74.1 4-112-19.2-37.2-49-61-89.5-71.5 10.4.3 20.7 1.5 31 3.5Z"></path>
          <path fill="#f9f9f9" d="M227.5 48.5c34.4-3.5 60.3 9.5 77.5 39 14.6 36.1 6.7 66.3-23.5 90.5-29.1 17.5-57.4 16.5-85-3-24.6-22-32.1-48.8-22.5-80.5 10.2-24.3 28-39.7 53.5-46Z"></path>
          <path fill="#faf9f9" d="M320.5 302.5c41.9-3.3 66.1 15.7 72.5 57 2.9 48.7-16.6 85.2-58.5 109.5-32.7 17.4-67 21.8-103 13-26.5-8-47.6-23.1-63.5-45.5-1-1.3-1.3-2.6-1-4 12.3 14.7 28.1 22.4 47.5 23 27.2-1.5 47-14.2 59.5-38 3.2-9.1 4.2-18.4 3-28-16.4-44.5-1.9-73.5 43.5-87Z"></path>
          <path fill="#fa547f" d="M324.5 342.5c9.4-1.7 16.3 1.6 20.5 10 .6 7.7-2.6 13.2-9.5 16.5-8.6 3.1-15.4 1-20.5-6.5-2.2-4.5-1.9-8.9 1-13 2.4-3 5.3-5.3 8.5-7Z"  ></path>
        </svg>

        <span
          class="hidden sm:block font-heading text-rose-900 font-semibold text-sm leading-tight"
        >
          {isEn ? "OB AAGU" : "ОВ ААГУ"}
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-4">
        {
          navItems.map((item) =>
            item.href ? (
              <a
                href={`${prefix}${item.href}`}
                class={`text-sm font-medium transition-colors duration-300 relative after:absolute after:bottom-[-4px] after:left-0 after:h-[2px] after:bg-rose-300 after:transition-all after:duration-300 ${isActiveRoute(item.href) ? "text-rose-300 after:w-full" : "text-rose-900/70 hover:text-rose-300 after:w-0 hover:after:w-full"}`}
                aria-current={
                  isActiveRoute(item.href)
                    ? "page"
                    : undefined
                }
              >
                {item.label}
              </a>
            ) : (
              <span class="text-sm font-medium text-rose-900/30 cursor-default select-none">
                {item.label}
              </span>
            ),
          )
        }
      </nav>

      <div class="flex items-center gap-4">
        <div class="hidden md:flex items-center gap-2">
          <a
            href="https://www.youtube.com/@ovaagu416"
            class="text-rose-900/40 hover:text-rose-300 transition-colors duration-300"
            ><Icon name="youtube" size={16} /></a
          >
          <a
            href=""
            class="text-rose-900/40 hover:text-rose-300 transition-colors duration-300 is-disabled"
            ><Icon name="facebook" size={16} /></a
          >
          <a
            href=""
            class="text-rose-900/40 hover:text-rose-300 transition-colors duration-300 is-disabled"
            ><Icon name="telegram" size={16} /></a
          >
        </div>
        <div class="flex items-center bg-rose-100 rounded-full p-0.5">
          <a
            href={ukHref}
            class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300 ${!isEn ? "bg-rose-300 text-white shadow-sm" : "text-rose-900/60 hover:text-rose-900"}`}
            >Ukr</a
          >
          <a
            href={enHref}
            class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300 ${isEn ? "bg-rose-300 text-white shadow-sm" : "text-rose-900/60 hover:text-rose-900"}`}
            >En</a
          >
        </div>
        <button
          id="mobile-menu-button"
          class="lg:hidden text-rose-900/70 hover:text-rose-300 transition-colors"
          aria-label="Menu"
        >
          <span data-menu-open><Icon name="menu" size={24} /></span>
          <span data-menu-close class="hidden"
            ><Icon name="close" size={24} /></span
          >
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-rose-50/95 backdrop-blur-xl border-t border-rose-200/50 overflow-hidden"
  >
    <nav class="px-6 py-6 flex flex-col gap-4">
      {
        navItems.map((item) =>
          item.href ? (
          <a
            href={`${prefix}${item.href}`}
            class:list={[
              "text-base font-medium transition-colors duration-300",
              isActiveRoute(item.href)
                ? "text-rose-300"
                : "text-rose-900/70 hover:text-rose-300",
            ]}
            aria-current={
              isActiveRoute(item.href)
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
          ) : (
            <span class="text-base font-medium text-rose-900/30 cursor-default">
              {item.label}
            </span>
          ),
        )
      }
      <div class="flex items-center gap-4 pt-4 border-t border-rose-200/50">
        <a
          href="https://www.youtube.com/@ovaagu416"
          class="text-rose-900/40 hover:text-rose-300 transition-colors"
          ><Icon name="youtube" size={18} /></a
        >
        <a
          href=""
          class="text-rose-900/40 hover:text-rose-300 transition-colors is-disabled"
          ><Icon name="facebook" size={18} /></a
        >
        <a
          href=""
          class="text-rose-900/40 hover:text-rose-300 transition-colors is-disabled"
          ><Icon name="send" size={18} /></a
        >
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const openIcon = button?.querySelector("[data-menu-open]");
  const closeIcon = button?.querySelector("[data-menu-close]");
  const isHome = location.pathname === "/" || location.pathname === "/en/";

  function updateHeader() {
    if (!header || !isHome) return;
    if (window.scrollY > 20) {
      header.classList.add("bg-rose-50/90", "backdrop-blur-xl", "shadow-sm");
      header.classList.remove("bg-transparent");
    } else {
      header.classList.remove("bg-rose-50/90", "backdrop-blur-xl", "shadow-sm");
      header.classList.add("bg-transparent");
    }
  }

  button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();
</script>
