---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../Header.astro";
import Footer from "../Footer.astro";
import Icon from "../Icon.astro";

type Lang = "uk" | "en";

interface Props {
  lang: Lang;
}

const {
  lang,
} = Astro.props;

const isEn = lang === "en";

const path = isEn
  ? "/en/contacts/"
  : "/contacts/";

const content = isEn
  ? {
      seoTitle: "Contacts — OB AAGU",
      seoDescription:
        "Contact information for the Odesa Branch of the Association of Obstetricians and Gynecologists of Ukraine.",
      eyebrow: "Contact information",
      title: "Contacts",
      intro:
        "Contact the Odesa Branch of the Association of Obstetricians and Gynecologists of Ukraine regarding organisational matters, professional activities and cooperation.",
      generalTitle: "General contacts",
      phoneLabel: "Phone",
      emailLabel: "Email",
      peopleTitle: "Contact persons",
      chairRole: "Chair of the Presidium",
      secretaryRole: "Secretary",
      mapTitle: "Location",
      mapDescription:
        "Use the interactive map to view the location and build a route.",
      routeButton: "Open in Google Maps",
      callButton: "Call",
      emailButton: "Send an email",
      mapLabel:
        "Map showing the Odesa Branch of the Association of Obstetricians and Gynecologists of Ukraine",
    }
  : {
      seoTitle: "Контакти — ОВ ААГУ",
      seoDescription:
        "Контактна інформація Одеського відділення Асоціації акушерів-гінекологів України.",
      eyebrow: "Контактна інформація",
      title: "Контакти",
      intro:
        "Зв’яжіться з Одеським відділенням Асоціації акушерів-гінекологів України з організаційних питань, щодо професійної діяльності та співпраці.",
      generalTitle: "Загальні контакти",
      phoneLabel: "Телефон",
      emailLabel: "Електронна пошта",
      peopleTitle: "Контактні особи",
      chairRole: "Голова Президії",
      secretaryRole: "Секретар",
      mapTitle: "Розташування",
      mapDescription:
        "Скористайтеся інтерактивною картою, щоб переглянути розташування та прокласти маршрут.",
      routeButton: "Відкрити в Google Maps",
      callButton: "Зателефонувати",
      emailButton: "Написати листа",
      mapLabel:
        "Карта розташування Одеського відділення Асоціації акушерів-гінекологів України",
    };

const contacts = {
  general: {
    phoneDisplay: "+38 (048) 705 99 78",
    phoneHref: "tel:+380487059978",
    email: "aagu.od@gmail.com",
  },

  people: [
    {
      role: content.chairRole,
      name: isEn
        ? "Gulsim Serikbaivna Manasova"
        : "Манасова Гульсим Серікбаївна",
      phoneDisplay: "+38 (050) 502 70 58",
      phoneHref: "tel:+380505027058",
    },
    {
      role: content.secretaryRole,
      name: isEn
        ? "Nataliia Vasylivna Kuzmyn"
        : "Кузьмин Наталія Василівна",
      phoneDisplay: "+38 (097) 686 82 36",
      phoneHref: "tel:+380976868236",
    },
  ],
};

const organisationName = isEn
  ? "Maternity №5"
  : "Пологовий будинок №5";

const mapQuery = encodeURIComponent(
  `${organisationName}, Odesa, Ukraine`,
);

const mapEmbedUrl =
  `https://www.google.com/maps?q=${mapQuery}&output=embed`;

const mapRouteUrl =
  "https://goo.gl/maps/QW2hDNUGAJu89iCH6";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: organisationName,
  url: new URL(
    path,
    Astro.site ??
      "https://odessa-gyne-association.pages.dev",
  ).toString(),
  email: contacts.general.email,
  telephone: "+380487059978",
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: "+380487059978",
      contactType: "general enquiries",
      availableLanguage: [
        "Ukrainian",
        "English",
      ],
    },
    {
      "@type": "ContactPoint",
      telephone: "+380505027058",
      contactType: "chair of presidium",
      availableLanguage: [
        "Ukrainian",
        "English",
      ],
    },
    {
      "@type": "ContactPoint",
      telephone: "+380976868236",
      contactType: "secretary",
      availableLanguage: [
        "Ukrainian",
        "English",
      ],
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={content.seoTitle}
  description={content.seoDescription}
  path={path}
  structuredData={structuredData}
>
  <Header
    lang={lang}
    currentPath={path}
  />

  <main class="contacts-page">
    <section class="contacts-hero">
      <div class="contacts-container">
        <header class="contacts-header">
          <p class="contacts-eyebrow">
            {content.eyebrow}
          </p>

          <h1>{content.title}</h1>

          <p class="contacts-intro">
            {content.intro}
          </p>
        </header>

        <div class="contacts-layout">
          <div class="contacts-information">
            <section
              class="contact-section"
              aria-labelledby="general-contacts-title"
            >
              <h2 id="general-contacts-title">
                {content.generalTitle}
              </h2>

              <div class="contact-card contact-card--primary">
                <div class="contact-row">
                  <span class="contact-icon">
                    <Icon
                      name="phone"
                      size={22}
                    />
                  </span>

                  <div class="contact-details">
                    <p class="contact-label">
                      {content.phoneLabel}
                    </p>

                    <a
                      href={contacts.general.phoneHref}
                      class="contact-value"
                    >
                      {contacts.general.phoneDisplay}
                    </a>
                  </div>
                </div>

                <div class="contact-row">
                  <span class="contact-icon">
                    <Icon
                      name="mail"
                      size={22}
                    />
                  </span>

                  <div class="contact-details">
                    <p class="contact-label">
                      {content.emailLabel}
                    </p>

                    <a
                      href={`mailto:${contacts.general.email}`}
                      class="contact-value"
                    >
                      {contacts.general.email}
                    </a>
                  </div>
                </div>

                <div class="contact-actions">
                  <a
                    href={contacts.general.phoneHref}
                    class="contact-button contact-button--primary"
                  >
                    <Icon
                      name="phone"
                      size={17}
                    />

                    <span>{content.callButton}</span>
                  </a>

                  <a
                    href={`mailto:${contacts.general.email}`}
                    class="contact-button"
                  >
                    <Icon
                      name="mail"
                      size={17}
                    />

                    <span>{content.emailButton}</span>
                  </a>
                </div>
              </div>
            </section>

            <section
              class="contact-section"
              aria-labelledby="contact-people-title"
            >
              <h2 id="contact-people-title">
                {content.peopleTitle}
              </h2>

              <div class="contact-people">
                {
                  contacts.people.map((person) => (
                    <article class="person-card">
                      <p class="person-role">
                        {person.role}
                      </p>

                      <h3>{person.name}</h3>

                      <a
                        href={person.phoneHref}
                        class="person-phone"
                      >
                        <Icon
                          name="phone"
                          size={16}
                        />

                        <span>
                          {person.phoneDisplay}
                        </span>
                      </a>
                    </article>
                  ))
                }
              </div>
            </section>
          </div>

          <section
            class="contacts-map-section"
            aria-labelledby="contacts-map-title"
          >
            <header class="contacts-map-header">
              <div>
                <p class="contacts-map-eyebrow">
                  {organisationName}
                </p>

                <h2 id="contacts-map-title">
                  {content.mapTitle}
                </h2>

                <p>
                  {content.mapDescription}
                </p>
              </div>

              <a
                href={mapRouteUrl}
                class="map-route-button"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon
                  name="map"
                  size={18}
                />

                <span>{content.routeButton}</span>

                <Icon
                  name="external-link"
                  size={15}
                />
              </a>
            </header>

            <div class="contacts-map">
              <iframe
                src={mapEmbedUrl}
                title={content.mapLabel}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          </section>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .contacts-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top left,
        rgba(244, 63, 94, 0.12),
        transparent 34rem
      ),
      linear-gradient(
        180deg,
        var(--color-brand-50) 0%,
        var(--color-surface) 45%
      );
  }

  .contacts-hero {
    padding: 9rem 0 5rem;
  }

  .contacts-container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .contacts-header {
    display: grid;
    gap: 1rem;
    max-width: 860px;
  }

  .contacts-eyebrow {
    margin: 0;
    color: var(--color-brand-600);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contacts-header h1 {
    margin: 0;
    color: var(--color-brand-900);
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .contacts-intro {
    max-width: 760px;
    margin: 0;
    color: var(--color-text-soft);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .contacts-layout {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .contacts-information {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .contact-section {
    display: grid;
    gap: 1.25rem;
  }

  .contact-section > h2,
  .contacts-map-header h2 {
    margin: 0;
    color: var(--color-brand-900);
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .contact-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.4rem, 4vw, 2rem);
    border: 1px solid rgba(136, 19, 55, 0.13);
    border-radius: 1.5rem;
    background: var(--color-surface);
    box-shadow:
      0 1.25rem 3.25rem rgba(136, 19, 55, 0.08);
  }

  .contact-card--primary {
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.98),
        rgba(255, 241, 242, 0.92)
      );
  }

  .contact-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .contact-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    color: var(--color-brand-600);
    background: var(--color-brand-100);
  }

  .contact-details {
    min-width: 0;
  }

  .contact-label {
    margin: 0 0 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact-value {
    color: var(--color-brand-900);
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: 800;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .contact-value:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .contact-button,
  .map-route-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-brand-200);
    border-radius: 999px;
    color: var(--color-brand-700);
    background: var(--color-surface);
    font-size: 0.875rem;
    font-weight: 800;
    text-decoration: none;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .contact-button:hover,
  .map-route-button:hover {
    border-color: var(--color-brand-600);
    transform: translateY(-2px);
  }

  .contact-button--primary {
    border-color: var(--color-brand-600);
    color: var(--color-surface);
    background: var(--color-brand-600);
  }

  .contact-people {
    display: grid;
    gap: 1rem;
  }

  .person-card {
    padding: 1.5rem;
    border: 1px solid rgba(136, 19, 55, 0.12);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.9);
  }

  .person-role {
    margin: 0 0 0.625rem;
    color: var(--color-brand-600);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .person-card h3 {
    margin: 0;
    color: var(--color-brand-900);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .person-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--color-text-soft);
    font-weight: 700;
    text-decoration: none;
  }

  .person-phone:hover {
    color: var(--color-brand-600);
  }

  .contacts-map-section {
    overflow: hidden;
    border: 1px solid rgba(136, 19, 55, 0.13);
    border-radius: 1.75rem;
    background: var(--color-surface);
    box-shadow:
      0 1.5rem 4rem rgba(136, 19, 55, 0.09);
  }

  .contacts-map-header {
    display: flex;
    gap: 2rem;
    align-items: flex-end;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .contacts-map-header > div {
    max-width: 650px;
  }

  .contacts-map-eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-brand-600);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contacts-map-header > div > p:last-child {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .map-route-button {
    flex: 0 0 auto;
  }

  .contacts-map {
    position: relative;
    min-height: 440px;
    background: var(--color-border-soft);
  }

  .contacts-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 820px) {
    .contacts-information {
      grid-template-columns: 1fr;
    }

    .contacts-map-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .contacts-hero {
      padding-top: 7.5rem;
    }

    .contacts-map {
      min-height: 360px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-button,
    .map-route-button {
      transition: none;
    }

    .contact-button:hover,
    .map-route-button:hover {
      transform: none;
    }
  }
</style>
