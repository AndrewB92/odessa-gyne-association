---
import BaseLayout from '../layouts/BaseLayout.astro';
import SitePage from '../components/SitePage.astro';
import { getNewsCategories, getNewsPosts } from '../lib/news';
import {
  getEventStatistics,
  getNormalizedEvents,
} from '../lib/events';

const [latestNews, newsCategories, events] = await Promise.all([
  getNewsPosts().then((posts) => posts.slice(0, 3)),
  getNewsCategories(),
  getNormalizedEvents({ lang: 'uk' }),
]);

const eventStatistics = getEventStatistics(events);
---

<BaseLayout lang="uk" title="Одеське відділення ААГУ">
  <SitePage
    lang="uk"
    page="home"
    currentPath="/"
    latestNews={latestNews}
    newsCategories={newsCategories}
    events={events}
    eventStatistics={eventStatistics}
  />
</BaseLayout>