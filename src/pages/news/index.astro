---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NewsArchive from "../../components/NewsArchive.astro";
import { getNewsCategories, getNewsPosts } from "../../lib/news";

const lang = "uk";
const posts = await getNewsPosts();
const categories = await getNewsCategories();
---

<BaseLayout
  lang={lang}
  title="Новини ОВ ААГУ"
  description="Анонси, події, оголошення та матеріали Одеського відділення Асоціації акушерів-гінекологів України."
  path="/news/"
>
  <Header lang={lang} currentPath="/news" />

  <main class="news-page">
    <section class="news-hero">
      <div class="news-container">
        <p class="news-eyebrow">Новини</p>
        <h1>Анонси, події та матеріали</h1>
        <p>
          Офіційні оновлення, професійні заходи, освітні матеріали та важливі
          повідомлення Одеського відділення ААГУ.
        </p>

        <NewsArchive posts={posts} categories={categories} lang={lang} />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .news-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(244, 63, 94, 0.12), transparent 34rem),
      linear-gradient(180deg, #fff7f9 0%, #ffffff 45%);
  }

  .news-hero {
    padding: 9rem 0 5rem;
  }

  .news-container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .news-eyebrow {
    margin: 0 0 0.85rem;
    color: #be123c;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-container h1 {
    max-width: 820px;
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .news-container > p:not(.news-eyebrow) {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .news-hero {
      padding-top: 7.5rem;
    }
  }
</style>