---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NewsArchive from "../../components/NewsArchive.astro";
import { getNewsCategories, getNewsPosts } from "../../lib/news";

const lang = "uk";
const posts = await getNewsPosts();
const categories = await getNewsCategories();
---

<BaseLayout
  lang={lang}
  title="Новини ОВ ААГУ"
  description="Анонси, події, оголошення та матеріали Одеського відділення Асоціації акушерів-гінекологів України."
  path="/news/"
>
  <Header lang={lang} currentPath="/news" />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">Новини</p>
        <h1 class="page-title">Анонси, події та матеріали</h1>
        <p class="page-intro">
          Офіційні оновлення, професійні заходи, освітні матеріали та важливі
          повідомлення Одеського відділення ААГУ.
        </p>

        <NewsArchive posts={posts} categories={categories} lang={lang} />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
