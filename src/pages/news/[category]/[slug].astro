---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import RichContent from "../../../components/RichContent.astro";
import NewsGallery from "../../../components/news/NewsGallery.astro";
import NewsVideos from "../../../components/news/NewsVideos.astro";
import NewsShare from "../../../components/news/NewsShare.astro";
import {
  formatNewsDate,
  getNewsCategories,
  getNewsPostUrl,
  getNewsPosts,
  getPostSlug,
  isExternalNewsPost,
} from "../../../lib/news";
import { renderMarkdown } from "../../../lib/markdown";

export async function getStaticPaths() {
  const posts = await getNewsPosts();

  return posts
    .filter((post) => !isExternalNewsPost(post))
    .map((post) => ({
      params: {
        category: post.data.category,
        slug: getPostSlug(post, "uk"),
      },
      props: { post },
    }));
}

const lang = "uk";
const { post } = Astro.props;
const categories = await getNewsCategories();
const category = categories.find((item) => item.data.slug === post.data.category);
const bodyHtml = renderMarkdown(post.data.bodyUk);

const title = post.data.seoTitle?.uk || post.data.title.uk;
const description =
  post.data.seoDescription?.uk ||
  post.data.excerpt?.uk ||
  "Новина Одеського відділення Асоціації акушерів-гінекологів України.";

const path = getNewsPostUrl(post, lang);
const site = Astro.site ?? new URL("https://odessa-gyne-association.pages.dev");
const canonicalUrl = new URL(path, site).toString();

const imageAlt = post.data.imageAlt?.uk || post.data.title.uk;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.data.title.uk, // use .en on English page
  description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt?.toISOString(),
  image: post.data.image
    ? [new URL(post.data.image, site).toString()]
    : undefined,
  mainEntityOfPage: canonicalUrl,
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  image={post.data.image}
  imageAlt={imageAlt}
  type="article"
  structuredData={structuredData}
>
  <Header lang={lang} currentPath="/news" />

  <main class="article-shell">
    <article class="article-section">
      <div class="article-container">
        <a class="page-back" href={`/news/${post.data.category}/`}>
          ← {category?.data.title.uk || "Новини"}
        </a>

        <header class="article-header">
          <div class="article-meta">
            {category && <span>{category.data.title.uk}</span>}
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatNewsDate(post.data.date, lang)}
            </time>
            {
              post.data.updatedAt && (
                <time datetime={post.data.updatedAt.toISOString()}>
                  Оновлено {formatNewsDate(post.data.updatedAt, lang)}
                </time>
              )
            }
          </div>

          <h1 class="article-title article-title--compact">{post.data.title.uk}</h1>

          {post.data.excerpt?.uk && <p class="article-intro">{post.data.excerpt.uk}</p>}
        </header>

        {post.data.image && (
          <img
            class="article-main-image"
            src={post.data.image}
            loading="eager"
            decoding="async"
            alt={imageAlt}
          />
        )}

        <section class="article-content-card">
          <RichContent>
            <Fragment set:html={bodyHtml} />
          </RichContent>
        </section>
        <NewsGallery gallery={post.data.gallery} lang={lang} />
        <NewsVideos videos={post.data.videos} lang={lang} />
        <NewsShare url={canonicalUrl} title={post.data.title.uk} lang={lang} />
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</BaseLayout>
