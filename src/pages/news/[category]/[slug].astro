---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import RichContent from "../../../components/RichContent.astro";
import NewsGallery from "../../../components/news/NewsGallery.astro";
import NewsVideos from "../../../components/news/NewsVideos.astro";
import NewsShare from "../../../components/news/NewsShare.astro";
import {
  formatNewsDate,
  getNewsCategories,
  getNewsPostUrl,
  getNewsPosts,
  getPostSlug,
  isExternalNewsPost,
} from "../../../lib/news";
import { renderMarkdown } from "../../../lib/markdown";

export async function getStaticPaths() {
  const posts = await getNewsPosts();

  return posts
    .filter((post) => !isExternalNewsPost(post))
    .map((post) => ({
      params: {
        category: post.data.category,
        slug: getPostSlug(post, "uk"),
      },
      props: { post },
    }));
}

const lang = "uk";
const { post } = Astro.props;
const categories = await getNewsCategories();
const category = categories.find((item) => item.data.slug === post.data.category);
const bodyHtml = renderMarkdown(post.data.bodyUk);

const title = post.data.seoTitle?.uk || post.data.title.uk;
const description =
  post.data.seoDescription?.uk ||
  post.data.excerpt?.uk ||
  "Новина Одеського відділення Асоціації акушерів-гінекологів України.";

const path = getNewsPostUrl(post, lang);
const site = Astro.site ?? new URL("https://odessa-gyne-association.pages.dev");
const canonicalUrl = new URL(path, site).toString();

const imageAlt = post.data.imageAlt?.uk || post.data.title.uk;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.data.title.uk, // use .en on English page
  description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.updatedAt?.toISOString(),
  image: post.data.image
    ? [new URL(post.data.image, site).toString()]
    : undefined,
  mainEntityOfPage: canonicalUrl,
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  image={post.data.image}
  imageAlt={imageAlt}
  type="article"
  structuredData={structuredData}
>
  <Header lang={lang} currentPath="/news" />

  <main class="news-single">
    <article class="news-article">
      <div class="news-container">
        <a class="news-back" href={`/news/${post.data.category}/`}>
          ← {category?.data.title.uk || "Новини"}
        </a>

        <header class="news-header">
          <div class="news-meta">
            {category && <span>{category.data.title.uk}</span>}
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatNewsDate(post.data.date, lang)}
            </time>
            {
              post.data.updatedAt && (
                <time datetime={post.data.updatedAt.toISOString()}>
                  Оновлено {formatNewsDate(post.data.updatedAt, lang)}
                </time>
              )
            }
          </div>

          <h1>{post.data.title.uk}</h1>

          {post.data.excerpt?.uk && <p>{post.data.excerpt.uk}</p>}
        </header>

        {post.data.image && (
          <img
            class="news-main-image"
            src={post.data.image}
            alt={post.data.title.uk}
            loading="eager"
            decoding="async"
            alt={imageAlt}
          />
        )}

        <section class="news-content">
          <RichContent>
            <Fragment set:html={bodyHtml} />
          </RichContent>
        </section>
        <NewsGallery gallery={post.data.gallery} lang={lang} />
        <NewsVideos videos={post.data.videos} lang={lang} />
        <NewsShare url={canonicalUrl} title={post.data.title.uk} lang={lang} />
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .news-single {
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(244, 63, 94, 0.12), transparent 34rem),
      linear-gradient(180deg, #fff7f9 0%, #ffffff 45%);
  }

  .news-article {
    padding: 9rem 0 5rem;
  }

  .news-container {
    width: min(980px, calc(100% - 32px));
    margin: 0 auto;
  }

  .news-back {
    display: inline-flex;
    margin-bottom: 2rem;
    color: #881337;
    font-weight: 800;
    text-decoration: none;
  }

  .news-back:hover {
    text-decoration: underline;
  }

  .news-header {
    max-width: 860px;
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-bottom: 1rem;
    color: #be123c;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-header h1 {
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.04;
  }

  .news-header p {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .news-main-image {
    display: block;
    width: 100%;
    margin: 2.5rem 0 0;
    border-radius: 2rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    box-shadow: 0 24px 70px rgba(136, 19, 55, 0.12);
  }

  .news-content {
    margin-top: 3rem;
    padding: clamp(1.35rem, 4vw, 3rem);
    border: 1px solid rgba(136, 19, 55, 0.12);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
  }

  @media (max-width: 720px) {
    .news-article {
      padding-top: 7.5rem;
    }

    .news-main-image,
    .news-content {
      border-radius: 1.35rem;
    }
  }
</style>