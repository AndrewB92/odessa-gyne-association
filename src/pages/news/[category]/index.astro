---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import NewsArchive from "../../../components/NewsArchive.astro";
import {
  getNewsCategories,
  getNewsCategoryBySlug,
  getNewsPosts,
} from "../../../lib/news";

export async function getStaticPaths() {
  const categories = await getNewsCategories();

  return categories.map((category) => ({
    params: { category: category.data.slug },
  }));
}

const lang = "uk";
const { category: categorySlug } = Astro.params;
const category = await getNewsCategoryBySlug(categorySlug!);

if (!category) {
  return Astro.redirect("/news/");
}

const posts = await getNewsPosts({ category: category.data.slug });
const categories = await getNewsCategories();
const title = `${category.data.title.uk} | Новини ОВ ААГУ`;
const description =
  category.data.description?.uk ||
  "Новини, події та матеріали Одеського відділення ААГУ.";
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={`/news/${category.data.slug}/`}
>
  <Header lang={lang} currentPath="/news" />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <a class="page-back" href="/news/">← Усі новини</a>
        <p class="page-eyebrow">Категорія</p>
        <h1 class="page-title">{category.data.title.uk}</h1>
        {category.data.description?.uk && <p class="page-intro">{category.data.description.uk}</p>}

        <NewsArchive
          posts={posts}
          categories={categories}
          lang={lang}
          showFilters={false}
          activeCategory={category.data.slug}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
