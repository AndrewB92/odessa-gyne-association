---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/ui/Section.astro';
import { getSite } from '../../../data/site';

const site = getSite('ua');
---

<BaseLayout lang="ua" route="contacts" title="Контакти" description="Контактна інформація асоціації.">
  <Section eyebrow="Контакти" title="Контакти" lead="Основна контактна інформація та канали зв’язку.">
    <div class="contact-card card">
      <p>{site.address}</p>
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {site.phone && <a href={`tel:${site.phone}`}>{site.phone}</a>}
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-card {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
    margin-top: var(--space-lg);
    padding: var(--space-lg);
  }

  .contact-card p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .contact-card a {
    color: var(--color-primary);
    font-weight: 800;
  }
</style>