---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import NewsArchive from "../../../components/NewsArchive.astro";
import { getNewsCategories, getNewsPosts } from "../../../lib/news";

const lang = "en";
const posts = await getNewsPosts();
const categories = await getNewsCategories();
---

<BaseLayout
  lang={lang}
  title="OB AAGU News"
  description="Announcements, events, notices and materials from the Odessa Branch of the Association of Obstetricians and Gynecologists of Ukraine."
  path="/en/news/"
>
  <Header lang={lang} currentPath="/en/news" />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">News</p>
        <h1 class="page-title">Announcements, events and materials</h1>
        <p class="page-intro">
          Official updates, professional events, educational materials and
          important notices from OB AAGU.
        </p>

        <NewsArchive posts={posts} categories={categories} lang={lang} />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
