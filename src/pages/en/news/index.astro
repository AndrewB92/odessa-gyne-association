---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/ui/Section.astro';
import ContentCard from '../../../components/content/ContentCard.astro';
import ContentList from '../../../components/content/ContentList.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';

const news = (await getCollection('news'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout lang="en" route="news" title="News" description="Latest association news and announcements.">
  <Section eyebrow="News" title="Latest news" lead="Updates, announcements, and professional community news.">
    <ContentList>
      {news.length > 0 ? (
        news.map((item) => (
          <ContentCard
            title={item.data.title}
            description={item.data.description}
            eyebrow={item.data.category ?? 'News'}
            date={item.data.date}
            href={`/en/news/${item.id}/`}
          />
        ))
      ) : (
        <EmptyState title="No news yet" description="News and announcements will appear here after they are added." />
      )}
    </ContentList>
  </Section>
</BaseLayout>