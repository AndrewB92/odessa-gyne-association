---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import RichContent from "../../../../components/RichContent.astro";
import {
  formatNewsDate,
  getNewsCategories,
  getNewsPostUrl,
  getNewsPosts,
  getPostSlug,
  isExternalNewsPost,
} from "../../../../lib/news";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getNewsPosts();

  return posts
    .filter((post) => !isExternalNewsPost(post))
    .map((post) => ({
      params: {
        category: post.data.category,
        slug: getPostSlug(post, "en"),
      },
      props: { post },
    }));
}

const lang = "en";
const { post } = Astro.props;
const categories = await getNewsCategories();
const category = categories.find((item) => item.data.slug === post.data.category);
const { Content } = await render(post);

const title = post.data.seoTitle?.en || post.data.title.en;
const description =
  post.data.seoDescription?.en ||
  post.data.excerpt?.en ||
  "News from the Odessa Branch of the Association of Obstetricians and Gynecologists of Ukraine.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.data.title.en,
  description,
  datePublished: post.data.date.toISOString(),
  image: post.data.image ? [post.data.image] : undefined,
  mainEntityOfPage: getNewsPostUrl(post, lang),
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={getNewsPostUrl(post, lang)}
  image={post.data.image}
  imageAlt={post.data.title.en}
  type="article"
  structuredData={structuredData}
>
  <Header lang={lang} currentPath="/en/news" />

  <main class="news-single">
    <article class="news-article">
      <div class="news-container">
        <a class="news-back" href={`/en/news/${post.data.category}/`}>
          ← {category?.data.title.en || "News"}
        </a>

        <header class="news-header">
          <div class="news-meta">
            {category && <span>{category.data.title.en}</span>}
            <time datetime={post.data.date.toISOString()}>
              {formatNewsDate(post.data.date, lang)}
            </time>
          </div>

          <h1>{post.data.title.en}</h1>

          {post.data.excerpt?.en && <p>{post.data.excerpt.en}</p>}
        </header>

        {post.data.image && (
          <img
            class="news-main-image"
            src={post.data.image}
            alt={post.data.title.en}
            loading="eager"
            decoding="async"
          />
        )}

        <section class="news-content">
          <RichContent>
            <Content />
          </RichContent>
        </section>
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .news-single {
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(244, 63, 94, 0.12), transparent 34rem),
      linear-gradient(180deg, #fff7f9 0%, #ffffff 45%);
  }

  .news-article {
    padding: 9rem 0 5rem;
  }

  .news-container {
    width: min(980px, calc(100% - 32px));
    margin: 0 auto;
  }

  .news-back {
    display: inline-flex;
    margin-bottom: 2rem;
    color: #881337;
    font-weight: 800;
    text-decoration: none;
  }

  .news-back:hover {
    text-decoration: underline;
  }

  .news-header {
    max-width: 860px;
  }

  .news-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-bottom: 1rem;
    color: #be123c;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-header h1 {
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2.35rem, 6vw, 4.75rem);
    line-height: 1.04;
  }

  .news-header p {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .news-main-image {
    display: block;
    width: 100%;
    margin: 2.5rem 0 0;
    border-radius: 2rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    box-shadow: 0 24px 70px rgba(136, 19, 55, 0.12);
  }

  .news-content {
    margin-top: 3rem;
    padding: clamp(1.35rem, 4vw, 3rem);
    border: 1px solid rgba(136, 19, 55, 0.12);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 20px 55px rgba(15, 23, 42, 0.08);
  }

  @media (max-width: 720px) {
    .news-article {
      padding-top: 7.5rem;
    }

    .news-main-image,
    .news-content {
      border-radius: 1.35rem;
    }
  }
</style>