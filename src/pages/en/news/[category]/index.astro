---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import NewsArchive from "../../../../components/NewsArchive.astro";
import {
  getNewsCategories,
  getNewsCategoryBySlug,
  getNewsPosts,
} from "../../../../lib/news";

export async function getStaticPaths() {
  const categories = await getNewsCategories();

  return categories.map((category) => ({
    params: { category: category.data.slug },
  }));
}

const lang = "en";
const { category: categorySlug } = Astro.params;
const category = await getNewsCategoryBySlug(categorySlug!);

if (!category) {
  return Astro.redirect("/en/news/");
}

const posts = await getNewsPosts({ category: category.data.slug });
const categories = await getNewsCategories();
const title = `${category.data.title.en} | OB AAGU News`;
const description =
  category.data.description?.en ||
  "News, events and materials from OB AAGU.";
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={`/en/news/${category.data.slug}/`}
>
  <Header lang={lang} currentPath="/en/news" />

  <main class="news-page">
    <section class="news-hero">
      <div class="news-container">
        <a class="news-back" href="/en/news/">← All news</a>
        <p class="news-eyebrow">Category</p>
        <h1>{category.data.title.en}</h1>
        {category.data.description?.en && <p>{category.data.description.en}</p>}

        <NewsArchive
          posts={posts}
          categories={categories}
          lang={lang}
          showFilters={false}
          activeCategory={category.data.slug}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .news-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(244, 63, 94, 0.12), transparent 34rem),
      linear-gradient(180deg, #fff7f9 0%, #ffffff 45%);
  }

  .news-hero {
    padding: 9rem 0 5rem;
  }

  .news-container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .news-back {
    display: inline-flex;
    margin-bottom: 2rem;
    color: #881337;
    font-weight: 800;
    text-decoration: none;
  }

  .news-back:hover {
    text-decoration: underline;
  }

  .news-eyebrow {
    margin: 0 0 0.85rem;
    color: #be123c;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-container h1 {
    max-width: 820px;
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .news-container > p:not(.news-eyebrow) {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .news-hero {
      padding-top: 7.5rem;
    }
  }
</style>