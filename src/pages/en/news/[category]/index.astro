---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import NewsArchive from "../../../../components/NewsArchive.astro";
import {
  getNewsCategories,
  getNewsCategoryBySlug,
  getNewsPosts,
} from "../../../../lib/news";

export async function getStaticPaths() {
  const categories = await getNewsCategories();

  return categories.map((category) => ({
    params: { category: category.data.slug },
  }));
}

const lang = "en";
const { category: categorySlug } = Astro.params;
const category = await getNewsCategoryBySlug(categorySlug!);

if (!category) {
  return Astro.redirect("/en/news/");
}

const posts = await getNewsPosts({ category: category.data.slug });
const categories = await getNewsCategories();
const title = `${category.data.title.en} | OB AAGU News`;
const description =
  category.data.description?.en ||
  "News, events and materials from OB AAGU.";
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={`/en/news/${category.data.slug}/`}
>
  <Header lang={lang} currentPath="/en/news" />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <a class="page-back" href="/en/news/">← All news</a>
        <p class="page-eyebrow">Category</p>
        <h1 class="page-title">{category.data.title.en}</h1>
        {category.data.description?.en && <p class="page-intro">{category.data.description.en}</p>}

        <NewsArchive
          posts={posts}
          categories={categories}
          lang={lang}
          showFilters={false}
          activeCategory={category.data.slug}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
