---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SitePage from '../../components/SitePage.astro';
import { getCollection } from 'astro:content';

const speakers = (await getCollection('speakers')).sort(
  (a, b) => a.data.sort - b.data.sort
);
---

<BaseLayout lang="en" title="Activities of OB AAGU">
  <SitePage lang="en" page="work" currentPath="/en/work" speakers={speakers} />
</BaseLayout>