---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

import BprCategoryArchive from "../../../components/bpr/BprCategoryArchive.astro";

export async function getStaticPaths() {
  const categories = await getCollection(
    "bprCategories",
    ({ data }) => !data.draft,
  );

  const events = await getCollection(
    "bprEvents",
  );

  return categories.map((category) => ({
    params: {
      category: category.data.slug,
    },

    props: {
      category,
      categories,
      events,
    },
  }));
}

interface Props {
  category: CollectionEntry<"bprCategories">;
  categories: CollectionEntry<"bprCategories">[];
  events: CollectionEntry<"bprEvents">[];
}

const {
  category,
  categories,
  events,
} = Astro.props;

const lang = "en";

const title = category.data.title.en;
const description =
  category.data.seoDescription?.en?.trim() ||
  category.data.description?.en?.trim() ||
  `BPR events in the “${title}” category.`;

const pageTitle =
  category.data.seoTitle?.en?.trim() ||
  `${title} — BPR OB AAGU`;

const path = `/en/bpr/${category.data.slug}/`;
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={description}
  path={path}
>
  <Header
    lang={lang}
    currentPath="/en/bpr"
  />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">
          BPR category
        </p>

        <h1 class="page-title">{title}</h1>

        {
          category.data.description?.en && (
            <p class="page-intro">
              {category.data.description.en}
            </p>
          )
        }

        <BprCategoryArchive
          category={category}
          events={events}
          categories={categories}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
