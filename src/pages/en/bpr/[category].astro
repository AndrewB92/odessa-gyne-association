---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

import BprCategoryArchive from "../../../components/bpr/BprCategoryArchive.astro";

export async function getStaticPaths() {
  const categories = await getCollection(
    "bprCategories",
    ({ data }) => !data.draft,
  );

  const events = await getCollection(
    "bprEvents",
  );

  return categories.map((category) => ({
    params: {
      category: category.data.slug,
    },

    props: {
      category,
      categories,
      events,
    },
  }));
}

interface Props {
  category: CollectionEntry<"bprCategories">;
  categories: CollectionEntry<"bprCategories">[];
  events: CollectionEntry<"bprEvents">[];
}

const {
  category,
  categories,
  events,
} = Astro.props;

const lang = "en";

const title = category.data.title.en;
const description =
  category.data.seoDescription?.en?.trim() ||
  category.data.description?.en?.trim() ||
  `BPR events in the “${title}” category.`;

const pageTitle =
  category.data.seoTitle?.en?.trim() ||
  `${title} — BPR OB AAGU`;

const path = `/en/bpr/${category.data.slug}/`;
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={description}
  path={path}
>
  <Header
    lang={lang}
    currentPath="/en/bpr"
  />

  <main class="bpr-category-page">
    <section class="bpr-category-hero">
      <div class="bpr-category-container">
        <p class="bpr-category-eyebrow">
          BPR category
        </p>

        <h1>{title}</h1>

        {
          category.data.description?.en && (
            <p class="bpr-category-description">
              {category.data.description.en}
            </p>
          )
        }

        <BprCategoryArchive
          category={category}
          events={events}
          categories={categories}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .bpr-category-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top left,
        rgba(244, 63, 94, 0.12),
        transparent 34rem
      ),
      linear-gradient(
        180deg,
        #fff7f9 0%,
        #ffffff 45%
      );
  }

  .bpr-category-hero {
    padding: 9rem 0 5rem;
  }

  .bpr-category-container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .bpr-category-eyebrow {
    margin: 0 0 0.85rem;
    color: #be123c;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bpr-category-container > h1 {
    max-width: 880px;
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .bpr-category-description {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .bpr-category-hero {
      padding-top: 7.5rem;
    }
  }
</style>