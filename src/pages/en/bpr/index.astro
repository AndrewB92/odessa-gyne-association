---
import { getCollection } from "astro:content";

import BprInformation from "../../../components/bpr/BprInformation.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

import BprArchive from "../../../components/bpr/BprArchive.astro";

const lang = "en";

const [
  events,
  categories,
] = await Promise.all([
  getCollection("bprEvents"),
  getCollection("bprCategories"),
]);
---

<BaseLayout
  lang={lang}
  title="BPR Events — OB AAGU"
  description="Continuing professional development events for obstetricians, gynecologists and other medical professionals."
  path="/en/bpr/"
>
  <Header
    lang={lang}
    currentPath="/en/bpr"
  />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">
          Continuing professional development
        </p>

        <h1 class="page-title">
          BPR events
        </h1>

        <p class="page-intro">
          Educational events, programmes,
          assessments and professional materials
          for medical specialists.
        </p>

        <BprInformation lang={lang} />

        <BprArchive
          events={events}
          categories={categories}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
