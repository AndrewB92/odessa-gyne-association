---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import ConferenceArchive from "../../components/conferences/ConferenceArchive.astro";

const lang = "uk";

const conferences = await getCollection(
  "conferences",
);
---

<BaseLayout
  lang={lang}
  title="Конференції ОВ ААГУ"
  description="Професійні конференції, конгреси та наукові зустрічі Одеського відділення Асоціації акушерів-гінекологів України."
  path="/conferences/"
>
  <Header
    lang={lang}
    currentPath="/conferences"
  />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">
          Конференції
        </p>

        <h1 class="page-title">
          Професійні конференції та наукові зустрічі
        </h1>

        <p class="page-intro">
          Актуальні та завершені конференції,
          конгреси й інші професійні заходи за
          участю медичної спільноти.
        </p>

        <ConferenceArchive
          conferences={conferences}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
