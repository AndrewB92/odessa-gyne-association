---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import ConferenceArchive from "../../components/conferences/ConferenceArchive.astro";

const lang = "uk";

const conferences = await getCollection(
  "conferences",
);
---

<BaseLayout
  lang={lang}
  title="Конференції ОВ ААГУ"
  description="Професійні конференції, конгреси та наукові зустрічі Одеського відділення Асоціації акушерів-гінекологів України."
  path="/conferences/"
>
  <Header
    lang={lang}
    currentPath="/conferences"
  />

  <main class="conferences-page">
    <section class="conferences-hero">
      <div class="conferences-container">
        <p class="conferences-eyebrow">
          Конференції
        </p>

        <h1>
          Професійні конференції та наукові зустрічі
        </h1>

        <p class="conferences-intro">
          Актуальні та завершені конференції,
          конгреси й інші професійні заходи за
          участю медичної спільноти.
        </p>

        <ConferenceArchive
          conferences={conferences}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .conferences-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top left,
        rgba(244, 63, 94, 0.12),
        transparent 34rem
      ),
      linear-gradient(
        180deg,
        #fff7f9 0%,
        #ffffff 45%
      );
  }

  .conferences-hero {
    padding: 9rem 0 5rem;
  }

  .conferences-container {
    width: min(
      1120px,
      calc(100% - 32px)
    );
    margin: 0 auto;
  }

  .conferences-eyebrow {
    margin: 0 0 0.85rem;
    color: #be123c;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .conferences-container > h1 {
    max-width: 880px;
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .conferences-intro {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .conferences-hero {
      padding-top: 7.5rem;
    }
  }
</style>