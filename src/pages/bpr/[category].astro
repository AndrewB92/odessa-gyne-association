---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import BprCategoryArchive from "../../components/bpr/BprCategoryArchive.astro";

export async function getStaticPaths() {
  const categories = await getCollection(
    "bprCategories",
    ({ data }) => !data.draft,
  );

  const events = await getCollection(
    "bprEvents",
  );

  return categories.map((category) => ({
    params: {
      category: category.data.slug,
    },

    props: {
      category,
      categories,
      events,
    },
  }));
}

interface Props {
  category: CollectionEntry<"bprCategories">;
  categories: CollectionEntry<"bprCategories">[];
  events: CollectionEntry<"bprEvents">[];
}

const {
  category,
  categories,
  events,
} = Astro.props;

const lang = "uk";

const title = category.data.title.uk;
const description =
  category.data.seoDescription?.uk?.trim() ||
  category.data.description?.uk?.trim() ||
  `Заходи БПР у категорії «${title}».`;

const pageTitle =
  category.data.seoTitle?.uk?.trim() ||
  `${title} — БПР ОВ ААГУ`;

const path = `/bpr/${category.data.slug}/`;
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={description}
  path={path}
>
  <Header
    lang={lang}
    currentPath="/bpr"
  />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">
          Категорія БПР
        </p>

        <h1 class="page-title">{title}</h1>

        {
          category.data.description?.uk && (
            <p class="page-intro">
              {category.data.description.uk}
            </p>
          )
        }

        <BprCategoryArchive
          category={category}
          events={events}
          categories={categories}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
