---
import { getCollection } from "astro:content";

import BprInformation from "../../components/bpr/BprInformation.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import BprArchive from "../../components/bpr/BprArchive.astro";

const lang = "uk";

const [
  events,
  categories,
] = await Promise.all([
  getCollection("bprEvents"),
  getCollection("bprCategories"),
]);
---

<BaseLayout
  lang={lang}
  title="БПР — ОВ ААГУ"
  description="Заходи безперервного професійного розвитку для акушерів-гінекологів та інших медичних фахівців."
  path="/bpr/"
>
  <Header
    lang={lang}
    currentPath="/bpr"
  />

  <main class="page-shell">
    <section class="page-hero">
      <div class="page-container">
        <p class="page-eyebrow">
          Безперервний професійний розвиток
        </p>

        <h1 class="page-title">
          Заходи БПР
        </h1>

        <p class="page-intro">
          Освітні заходи, програми, тестування
          та професійні матеріали для медичних
          фахівців.
        </p>

        <BprInformation lang={lang} />

        <BprArchive
          events={events}
          categories={categories}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
