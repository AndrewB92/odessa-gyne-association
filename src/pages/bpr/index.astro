---
import { getCollection } from "astro:content";

import BprInformation from "../../components/bpr/BprInformation.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import BprArchive from "../../components/bpr/BprArchive.astro";

const lang = "uk";

const [
  events,
  categories,
] = await Promise.all([
  getCollection("bprEvents"),
  getCollection("bprCategories"),
]);
---

<BaseLayout
  lang={lang}
  title="БПР — ОВ ААГУ"
  description="Заходи безперервного професійного розвитку для акушерів-гінекологів та інших медичних фахівців."
  path="/bpr/"
>
  <Header
    lang={lang}
    currentPath="/bpr"
  />

  <main class="bpr-page">
    <section class="bpr-hero">
      <div class="bpr-container">
        <p class="bpr-eyebrow">
          Безперервний професійний розвиток
        </p>

        <h1>
          Заходи БПР
        </h1>

        <p class="bpr-intro">
          Освітні заходи, програми, тестування
          та професійні матеріали для медичних
          фахівців.
        </p>

        <BprInformation lang={lang} />

        <BprArchive
          events={events}
          categories={categories}
          locale={lang}
        />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .bpr-page {
    min-height: 100vh;
    background:
      radial-gradient(
        circle at top left,
        rgba(244, 63, 94, 0.12),
        transparent 34rem
      ),
      linear-gradient(
        180deg,
        #fff7f9 0%,
        #ffffff 45%
      );
  }

  .bpr-hero {
    padding: 9rem 0 5rem;
  }

  .bpr-container {
    width: min(
      1120px,
      calc(100% - 32px)
    );
    margin: 0 auto;
  }

  .bpr-eyebrow {
    margin: 0 0 0.85rem;
    color: #be123c;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bpr-container > h1 {
    max-width: 880px;
    margin: 0;
    color: #881337;
    font-family: Domine, serif;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1;
  }

  .bpr-intro {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: #475569;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .bpr-hero {
      padding-top: 7.5rem;
    }
  }
</style>