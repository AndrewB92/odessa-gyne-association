---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Article from '../../components/content/Article.astro';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);

  return events.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <Section eyebrow="Event" title={item.data.title} lead={item.data.description}>
    <Article>
      <dl class="event-meta card">
        <div>
          <dt>Date</dt>
          <dd>
            <time datetime={item.data.date.toISOString()}>
              {item.data.date.toLocaleDateString('en-GB')}
            </time>
          </dd>
        </div>

        {item.data.location && (
          <div>
            <dt>Location</dt>
            <dd>{item.data.location}</dd>
          </div>
        )}
      </dl>

      <Content />

      {item.data.registrationUrl && (
        <div class="article-actions">
          <Button href={item.data.registrationUrl} target="_blank">Register</Button>
        </div>
      )}
    </Article>
  </Section>
</BaseLayout>

<style>
  .event-meta {
    display: grid;
    gap: 1rem;
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
  }

  .event-meta div {
    display: grid;
    gap: 0.25rem;
  }

  .event-meta dt {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-meta dd {
    margin: 0;
    color: var(--color-primary);
    font-weight: 850;
  }

  .event-meta time {
    margin-bottom: 0;
  }

  .article-actions {
    margin-top: var(--space-lg);
  }
</style>