---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import SpeakersArchive from "../../components/speakers/SpeakersArchive.astro";

const lang = "uk";

const speakers = await getCollection("speakers");
---

<BaseLayout
  lang={lang}
  title="Спікери — ОВ ААГУ"
  description="Фахівці та спікери професійних і освітніх заходів Одеського відділення Асоціації акушерів-гінекологів України."
  path="/speakers/"
>
  <Header
    lang={lang}
    currentPath="/speakers"
  />

  <main>
    <SpeakersArchive
      speakers={speakers}
      lang={lang}
    />
  </main>

  <Footer lang={lang} />
</BaseLayout>