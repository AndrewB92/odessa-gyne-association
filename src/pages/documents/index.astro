---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import ContentCard from '../../components/content/ContentCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { getDocumentTypeLabel } from '../../lib/labels';

const documents = (await getCollection('documents'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => {
    const dateA = a.data.date?.valueOf() ?? 0;
    const dateB = b.data.date?.valueOf() ?? 0;

    return dateB - dateA;
  });
---

<BaseLayout title="Documents" description="Useful documents, protocols, reports, and materials.">
  <Section
    eyebrow="Documents"
    title="Documents"
    lead="Regulations, protocols, reports, and useful materials."
  >
    <div class="content-list">
      {documents.length > 0 ? (
        documents.map((item) => (
          <ContentCard
            title={item.data.title}
            description={item.data.description}
            eyebrow={getDocumentTypeLabel(item.data.type)}
            date={item.data.date}
            href={item.data.fileUrl}
          />
        ))
      ) : (
        <EmptyState
          title="No documents yet"
          description="Documents and useful materials will appear here after they are added."
        />
      )}
    </div>
  </Section>
</BaseLayout>

<style>
  .content-list {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
</style>